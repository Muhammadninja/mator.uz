# Install as /etc/mator/backend-staging.env, mode 0600, owned by mator-backend-staging.
# This is a dedicated file, not an overlay on production .env. Never copy production secrets.
NODE_ENV=staging
PORT=3001
BIND_HOST=127.0.0.1
LOG_LEVEL=warn
ENABLE_SWAGGER=false
BLUEPRINT_ENABLED=false
AUTH_DEV_MODE=false

# Create this role/database with scripts/staging/create-staging-db.sh.
DATABASE_URL=postgresql://mator_backend_staging:replace-with-db-password@127.0.0.1:5432/mator_staging?schema=public
DIRECT_URL=postgresql://mator_backend_staging:replace-with-db-password@127.0.0.1:5432/mator_staging?schema=public

# Must be a separate Redis server/instance. This backend has no Redis DB or BullMQ prefix setting.
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=replace-with-staging-redis-password

# Separate staging Cloudinary account is required by the backend module at startup.
CLOUDINARY_CLOUD_NAME=replace-with-staging-cloud-name
CLOUDINARY_API_KEY=replace-with-staging-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-staging-cloudinary-api-secret

# Match VEHICLE_IMAGE_REQUEST_TOKEN in the staging pipeline env file exactly.
VEHICLE_IMAGES_ENABLED=true
VEHICLE_IMAGE_PIPELINE_URL=http://127.0.0.1:8048
VEHICLE_IMAGE_REQUEST_TOKEN=replace-with-the-same-staging-service-token

# Safe staging-only integrations. Do not configure production payment, SMS, or bot credentials.
PAYMENT_PROVIDERS=
SMS_PROVIDER=log
TELEGRAM_BOT_TOKEN=
SOURCING_TICKETS_ENABLED=false

# Generate an independent staging keypair for stable staging sessions; never copy production keys.
JWT_PRIVATE_KEY=replace-with-staging-private-key-pem-escaped-newlines
JWT_PUBLIC_KEY=replace-with-staging-public-key-pem-escaped-newlines
JWT_KID=mator-staging-key
JWT_AUDIENCE=mator-staging
CORS_ORIGINS=
