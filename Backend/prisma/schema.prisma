// ── SMS accounting & operator pricing ─────────────────────────────────────────
// Additive analytics layer around the EXISTING SMS send path — no existing table,
// endpoint, provider, or the SmsProvider interface is touched. An SmsMessage row
// is written at send time with status='pending'; a future delivery callback (not
// yet implemented) flips status→delivered/failed and fills delivered_at, so no
// schema change is needed to add delivery tracking later.

model SmsOperator {
  id          Int                 @id @default(autoincrement())
  // Canonical, stable key (e.g. "beeline"); snapshotted onto SmsMessage.operatorName.
  name        String              @unique @db.VarChar(40)
  displayName String              @map("display_name") @db.VarChar(80)
  // Current price per SMS in UZS. NEVER used to recompute historical cost — each
  // SmsMessage snapshots the price in force at send time (see SmsMessage.priceUzs).
  priceUzs    Int                 @map("price_uzs")
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  prefixes    SmsOperatorPrefix[]
  messages    SmsMessage[]

  @@map("sms_operators")
}

model SmsOperatorPrefix {
  id         Int         @id @default(autoincrement())
  operatorId Int         @map("operator_id")
  // 2-digit MSISDN operator code after the 998 country code (e.g. "90"). Globally
  // unique: a prefix maps to exactly one operator.
  prefix     String      @unique @db.VarChar(8)
  operator   SmsOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
  @@map("sms_operator_prefixes")
}

model SmsMessage {
  id                    Int          @id @default(autoincrement())
  // Transport that accepted the send (SmsProvider.name, e.g. "sayqal").
  provider              String       @db.VarChar(40)
  // Provider-returned identifiers/parts. Null at insert: the SmsProvider contract
  // returns void, so these are reserved for a later delivery callback.
  providerTransactionId String?      @map("provider_transaction_id") @db.VarChar(120)
  providerSmsId         String?      @map("provider_sms_id") @db.VarChar(120)
  phoneE164             String       @map("phone_e164") @db.VarChar(20)
  // Operator snapshot — resolved at send time and frozen. operatorName/priceUzs
  // are copies, never re-derived from SmsOperator, so historical cost is immutable
  // against later price edits. operatorId is a soft link (SET NULL on delete).
  operatorId            Int?         @map("operator_id")
  operatorName          String?      @map("operator_name") @db.VarChar(40)
  priceUzs              Int?         @map("price_uzs")
  // Optional message-template label (never the rendered text — OTP codes are not
  // persisted). Nullable for callers that don't tag their sends.
  template              String?      @db.VarChar(60)
  parts                 Int?
  // Lifecycle: 'pending' at insert → 'delivered' | 'failed' via future callback.
  status                String       @default("pending") @db.VarChar(20)
  errorCode             String?      @map("error_code") @db.VarChar(40)
  errorMessage          String?      @map("error_message") @db.Text
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  deliveredAt           DateTime?    @map("delivered_at") @db.Timestamptz(3)
  operator              SmsOperator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([operatorId])
  @@index([createdAt])
  @@index([phoneE164])
  @@map("sms_messages")
}

// ── Admin panel authentication ───────────────────────────────────────────────
// Completely separate identity space from AppUser: admins are staff accounts for
// the back-office console, log in with email + password (never OTP), and their
// tokens are signed with a different key/algorithm/audience than the mobile
// app's (see AdminTokenService). Nothing here references app_users, and the
// mobile OTP flow is untouched.

enum AdminRole {
  SUPER_ADMIN
  MANAGER
  OPERATOR
}

/// Critical, security-relevant actions on administrator accounts. Only lifecycle
/// and privilege changes belong here — routine reads are not audited.
enum AdminAuditAction {
  CREATE_ADMIN
  DEACTIVATE_ADMIN
  REACTIVATE_ADMIN
  CHANGE_ROLE
  CHANGE_PASSWORD
  RESET_PASSWORD
  DELETE_ADMIN
  // Invite-only admin signup. INVITE_ADMIN is written when a SUPER_ADMIN issues
  // an invite (target = the invited email); ACCEPT_INVITE when the invitee
  // completes signup (target = the newly created admin account).
  INVITE_ADMIN
  ACCEPT_INVITE
  // Dealer moderation (/v1/admin/dealers). The target is a dealer, not an
  // administrator, so these entries carry targetEntity/targetEntityId rather
  // than targetAdminId — see AdminAudit.
  DEALER_CERTIFIED_ENABLED
  DEALER_CERTIFIED_DISABLED
  DEALER_LOWEST_PRICE_ENABLED
  DEALER_LOWEST_PRICE_DISABLED
  DEALER_APPROVED
  DEALER_SUSPENDED
  DEALER_REACTIVATED
  DEALER_UPDATED
}

// What kind of thing an audit entry is about, for entries whose target is not
// an administrator account. Null on the admin-account actions, which keep using
// the targetAdminId FK.
enum AdminAuditEntity {
  DEALER
}

model AppAdmin {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(255)
  // Bcrypt hash only — the plaintext password is never stored, logged or returned.
  passwordHash String    @map("password_hash") @db.VarChar(255)
  name         String    @db.VarChar(120)
  role         AdminRole @default(OPERATOR)
  isActive     Boolean   @default(true) @map("is_active")
  // Session version — mirrors AppUser.tokenVersion: bumping it invalidates every
  // outstanding admin access token on the next request (deactivation, password
  // change, refresh-token reuse).
  tokenVersion Int       @default(0) @map("token_version")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens AdminRefreshToken[]
  auditsPerformed AdminAudit[] @relation("AdminAuditActor")
  auditsReceived  AdminAudit[] @relation("AdminAuditTarget")
  invitesSent     AdminInvite[] @relation("AdminInviteInviter")

  @@map("app_admins")
}

/// Append-only audit trail for critical administrator actions (creation, role
/// changes, deactivation, password changes, deletion).
///
/// Two properties make this trustworthy:
///
///   • Actor and target identities are SNAPSHOTS taken at write time — like
///     OrderStatusHistory's actor columns — so an entry keeps saying WHO did
///     WHAT to WHOM even after either account is renamed or deleted.
///   • Both FKs are ON DELETE SET NULL, never CASCADE: deleting an administrator
///     must not erase the record of what they did, or of their own deletion.
///     That would let anyone destroy their own trail by removing the account.
///
/// Rows are never updated or deleted by application code.
model AdminAudit {
  id             String           @id @default(cuid())
  action         AdminAuditAction
  // Who performed it. Null only for actions with no signed-in actor — the CLI
  // bootstrap of the first SUPER_ADMIN (see actorLabel).
  actorId        String?          @map("actor_id")
  actorEmail     String?          @map("actor_email") @db.VarChar(255)
  actorName      String?          @map("actor_name") @db.VarChar(120)
  // Human-readable origin for actions with no admin actor, e.g. "cli:admin:create".
  actorLabel     String?          @map("actor_label") @db.VarChar(60)
  // Which account it was performed on.
  targetAdminId  String?          @map("target_admin_id")
  targetEmail    String?          @map("target_email") @db.VarChar(255)
  targetName     String?          @map("target_name") @db.VarChar(120)
  // Before/after for privilege changes (CHANGE_ROLE). Null for other actions.
  previousRole   AdminRole?       @map("previous_role")
  newRole        AdminRole?       @map("new_role")
  // Target for actions performed on something OTHER than an administrator
  // account — today a dealer. targetAdminId cannot carry these: it is an FK to
  // app_admins, so a dealer id would violate it. Deliberately NOT a foreign key
  // itself: the trail is append-only and must survive deletion of its subject,
  // which is also why targetName above snapshots the display name at write time.
  targetEntity   AdminAuditEntity? @map("target_entity")
  targetEntityId String?           @map("target_entity_id") @db.VarChar(64)
  // Before/after snapshot of the changed fields, e.g.
  // {"certified": false} → {"certified": true}. Only the fields the action
  // touched, never a whole row — and never a credential.
  previousValues Json?             @map("previous_values")
  newValues      Json?             @map("new_values")
  // Free-text reason supplied by the acting admin (dealer suspension).
  reason         String?           @db.VarChar(500)
  // Request provenance. Untrusted and display-only — never an authorization input.
  ip             String?          @db.VarChar(45)
  userAgent      String?          @map("user_agent") @db.VarChar(400)
  // Correlation id of the HTTP request that performed the action. Grepping the
  // server log for it returns the whole story of the incident — the HTTP entry,
  // any exception, and this audit write — with no join table.
  requestId      String?          @map("request_id") @db.VarChar(64)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  actor  AppAdmin? @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  target AppAdmin? @relation("AdminAuditTarget", fields: [targetAdminId], references: [id], onDelete: SetNull)

  @@index([targetAdminId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  // "everything that happened to this dealer", newest first.
  @@index([targetEntity, targetEntityId, createdAt])
  @@map("admin_audits")
}

// One row per SESSION, not per admin: every login creates a new row, so an admin
// signed in on a laptop, a home PC and a work PC holds three independent,
// coexisting sessions that never evict one another. The metadata columns exist
// so those sessions can be listed and revoked individually ("sign out this
// device") rather than only all at once.
model AdminRefreshToken {
  id           Int       @id @default(autoincrement())
  // SHA-256 of the opaque token; the raw value exists only in the client's hands.
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  adminId      String    @map("admin_id")
  tokenVersion Int       @default(0) @map("token_version")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  // Soft-rotation marker: a consumed row is kept so a replay is detectable as
  // reuse rather than simply "not found".
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(3)
  // Explicit single-session revocation (logout / "sign out this device"). Kept
  // distinct from consumedAt: consumed means "rotated normally", revoked means
  // "deliberately killed", and only the former is a theft signal when replayed.
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  // Session provenance, for the "active sessions" list. Client-supplied and
  // therefore untrusted — display-only, never used for an authorization
  // decision. Carried across rotation so a session keeps its identity.
  deviceName   String?   @map("device_name") @db.VarChar(120)
  ip           String?   @db.VarChar(45) // 45 = max INET6_ADDRSTRLEN
  userAgent    String?   @map("user_agent") @db.VarChar(400)
  // Refreshed on every rotation, so the list can show "last active".
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  admin        AppAdmin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_refresh_tokens")
}

/// Invite-only admin signup. A SUPER_ADMIN invites a specific email; a one-time,
/// expiring link is emailed; the invitee sets a password and their account is
/// created. Mirrors the refresh-token security posture:
///
///   • Only the SHA-256 hash of the opaque token is stored — the raw token exists
///     solely in the emailed link, so a leaked DB row cannot be turned back into
///     a usable invite.
///   • Single-use: `acceptedAt` is stamped on acceptance and a used invite is
///     never honoured again.
///   • Short-lived: `expiresAt` (48h) is checked on both preview and accept.
///
/// `invitedById` is ON DELETE SET NULL so removing the inviting admin never
/// deletes the pending invite (or its record). Rows are safe to prune after
/// expiry/acceptance but are not cascaded away with the inviter.
model AdminInvite {
  id          String    @id @default(cuid())
  email       String    @db.VarChar(255)
  // SHA-256 hex of the opaque token; the raw value lives only in the emailed link.
  tokenHash   String    @map("token_hash") @db.VarChar(64)
  role        AdminRole @default(OPERATOR)
  invitedById String?   @map("invited_by_id")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  // Stamped when the invitee sets their password; a used invite is never re-honoured.
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  invitedBy AppAdmin? @relation("AdminInviteInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([tokenHash])
  @@index([email])
  @@map("admin_invites")
}

// ── Sales (automatic discounts) ───────────────────────────────────────────────
// Entirely separate from the promo-code system (Cart.promoCode / promo.util.ts):
// a promo code is entered by the buyer and discounts a whole cart, whereas a
// sale is created in the admin panel, applies automatically with no user input,
// and discounts a PRODUCT. The two never share a table, a column or a code path.

/// How a sale's discountValue is interpreted. PERCENT is a 0–100 percentage of
/// the original price; FIXED is an absolute amount in the price's own currency
/// (UZS), floored at zero so a discount can never produce a negative price.
enum SaleDiscountType {
  PERCENT
  FIXED
}

/// What a sale applies to. ALL_PRODUCTS is the only self-contained value — the
/// other three are resolved through SaleTarget rows, one per selected product,
/// category or dealer.
///
/// Adding a scope later (a brand, a vehicle make, a price band) needs NO schema
/// change beyond a new value here: SaleTarget.targetId is a plain id column with
/// no FK precisely so a new kind of target needs no new table and no migration
/// of existing rows. The service resolves scope through one table-driven map.
enum SaleScopeType {
  ALL_PRODUCTS
  PRODUCTS
  CATEGORIES
  DEALERS
}

/// An automatic discount campaign. Applied by the backend, never computed by a
/// mobile client. A sale is "active" when isActive is true and now falls inside
/// [startAt, endAt] — endAt null meaning open-ended.
model Sale {
  id           String           @id @db.VarChar(64)
  title        String           @db.VarChar(160)
  description  String?          @db.VarChar(1000)
  discountType SaleDiscountType @map("discount_type")
  // PERCENT: 0 < value <= 100. FIXED: value > 0, in whole/fractional UZS.
  // Decimal (not Float) so a percentage like 12.5 and a money amount are both
  // exact — the same 14,2 shape CatalogPart.priceUzs uses for money.
  discountValue Decimal         @map("discount_value") @db.Decimal(14, 2)
  // Targeting. ALL_PRODUCTS ignores `targets`; every other scope reads them.
  scopeType    SaleScopeType    @default(ALL_PRODUCTS) @map("scope_type")
  startAt      DateTime         @map("start_at") @db.Timestamptz(3)
  // Null = runs until switched off.
  endAt        DateTime?        @map("end_at") @db.Timestamptz(3)
  isActive     Boolean          @default(true) @map("is_active")
  // Which sale wins when several apply to one product. Higher runs first; ties
  // break on the deeper discount, then on id, so the choice is deterministic.
  priority     Int              @default(0)
  // Soft delete. DELETE /v1/admin/sales/:id stamps this instead of removing the
  // row, so a campaign that ran — and the prices it produced — stays on file and
  // auditable. A deleted sale is invisible to every list and never applies to a
  // price; null means "not deleted", which is the state of every existing row.
  //
  // Distinct from isActive: isActive is an operational switch an admin flips back
  // and forth, deletedAt is terminal.
  deletedAt    DateTime?        @map("deleted_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  targets      SaleTarget[]

  // Covers the active-sale lookup: deletedAt and isActive first (most
  // selective), then the window bounds both endpoints filter on.
  @@index([deletedAt, isActive, startAt, endAt])
  @@map("sales")
}

/// One selected target of a scoped sale — a product, a category or a dealer.
/// `targetType` mirrors the parent sale's scopeType, so a single row is
/// self-describing and a future scope kind slots in without a new table.
///
/// targetId is deliberately NOT a foreign key: the three target kinds live in
/// three different tables (catalog_parts, part_categories, catalog_sellers) and
/// no single FK can point at all of them. The service validates existence at
/// write time; a target whose subject is later deleted simply stops matching.
model SaleTarget {
  id         String        @id @db.VarChar(64)
  saleId     String        @map("sale_id") @db.VarChar(64)
  targetType SaleScopeType @map("target_type")
  targetId   String        @map("target_id") @db.VarChar(64)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  sale       Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  // The same subject cannot be attached to one sale twice.
  @@unique([saleId, targetType, targetId])
  @@index([saleId])
  // "which sales target this product/category/dealer" — the discount lookup.
  @@index([targetType, targetId])
  @@map("sale_targets")
}
