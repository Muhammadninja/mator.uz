// ─────────────────────────────────────────────────────────────────────────────
// Mator schema — foundation aligned to the mobile frontend contract (backend.json)
//
// ID conventions:
//   • AppUser            -> UUID (@db.Uuid)
//   • Buyer/transactional -> app-generated prefixed ULID strings (veh_, ord_,
//     pay_, bk_, ai_, msg_, ntf_, dev_, addr_, otp_, myid_*) — generated in the
//     service layer, never exposed as Int.
//   • Catalog reference   -> stable slug strings (make_chevrolet, cat_engine_belts,
//     trim_…, engine_…, svc_…, brand_gates, seller_avtomir).
//   • Internal marketplace (Seller/Telegram/Product/Stock/Brand/CarModel) keeps
//     Int PKs — supply-side bounded context, NOT exposed in the buyer app.
//
// Line-items (order/cart/booking) use a snapshot pattern: plain id columns +
// denormalized title/price, so historical records are immutable against catalog
// changes (no FK cascade on snapshots).
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────
enum SellerStatus {
  PENDING
  ACTIVE
  REJECTED
}

// What KIND of party a supply-side seller is.
//   TELEGRAM → a seller who onboarded through the Telegram bot. tg_id (their
//              Telegram user id, which is also their chat id) and phone are
//              REQUIRED — enforced by the CHECK constraint
//              sellers_telegram_identity_check, so every existing row and every
//              bot-created row keeps exactly the guarantees it had before.
//   BUSINESS → an organization whose stock arrives through an integration
//              (e.g. Driver's Village 1C). It has no Telegram account, so tg_id
//              is NULL — never a fabricated id — and it cannot be reached or
//              impersonated through the bot, which looks sellers up by tg_id.
// Internal to the supply side: never exposed by the buyer API.
enum SellerType {
  TELEGRAM
  BUSINESS
}

/// The interface language a seller picked in the Telegram bot. Stored as an
/// enum (not a free string) so an unsupported code cannot reach the DB; the
/// wire/bot representation is the lowercase ISO code ('ru' | 'uz' | 'en').
enum BotLanguage {
  RU
  UZ
  EN
}

enum Role {
  USER
  SELLER
  ADMIN
}

enum AuthProvider {
  GOOGLE
  APPLE
  PHONE_OTP
  MYID
}

enum MyIdStatus {
  NOT_VERIFIED
  PENDING
  VERIFIED
}

/// The legal documents a user must consent to. One enum member per DOCUMENT —
/// deliberately not merged into a single "terms" record, because each is a
/// separately versioned instrument that can be re-issued (and must be
/// re-accepted) on its own schedule.
enum LegalDocumentType {
  TERMS_OF_USE
  PRIVACY_POLICY
  PERSONAL_DATA_CONSENT
  /// Informational, never accepted: shown at checkout, in Legal Documents and
  /// from a delivered order. Not in REQUIRED_LEGAL_DOCUMENT_TYPES.
  REFUND_POLICY
}

enum OtpChannel {
  SMS
  TELEGRAM
}

enum Gender {
  MALE
  FEMALE
}

enum Language {
  RU
  UZ
  EN
}

enum ProviderType {
  MASTER
  STO
}

enum Specialization {
  ENGINE
  TRANSMISSION
  ELECTRICAL
  BODY
  PAINT
  SUSPENSION
  DIAGNOSTICS
  TIRES
  AC
}

enum VehicleTransmission {
  MANUAL
  AUTOMATIC
  CVT
  AMT
  ROBOT
}

enum Drivetrain {
  FWD
  RWD
  AWD
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  GAS
}

enum VehicleServiceStage {
  QUEUED
  IN_PROGRESS
  AWAITING_PARTS
  READY
  FLAGGED
}

enum CompatibilityStatus {
  FITS
  MAYBE
  DOES_NOT_FIT
}

enum PartCondition {
  NEW
  USED
  REFURBISHED
}

// ── Parts taxonomy (classified by the Telegram bot from title + description) ──
// Two-level category hierarchy. MAIN categories are the home-page grid; VEHICLE
// categories group parts once a make/model is chosen. Both are stored on every
// product so the buyer catalog can filter/facet without extra processing.
enum PartMainCategory {
  BRAKES
  BATTERIES
  FILTERS
  IGNITION
  ENGINE
  ELECTRICAL_PARTS
  OIL_AND_FLUIDS
  BELTS_AND_HOSES
  WIPERS
  LIGHTING
  SUSPENSION
  EXTERIOR
}

// What KIND of thing a listing is. The Telegram wizard runs a different
// questionnaire per kind, and each kind owns its own attribute columns:
//   SPARE_PART → vehicle fitment + GM/OEM part numbers (the original flow)
//   MOTOR_OIL  → viscosity / oil type / volume; NO fitment, NO part numbers
//   ANTIFREEZE → net weight in grams, sold by the KILOGRAM (never "шт")
// Additive by design: a new "Другое" category (brake fluid, batteries, …)
// becomes a new value here plus its own attribute columns, without touching
// any existing kind. SPARE_PART is the default so every pre-existing row keeps
// its current meaning.
enum ProductKind {
  SPARE_PART
  MOTOR_OIL
  ANTIFREEZE
}

// Base composition of a motor oil, as chosen by the seller (never inferred).
enum OilType {
  SYNTHETIC
  SEMI_SYNTHETIC
  MINERAL
}

// The FORM a listing is sold in — one item ("Штука"), a set ("Комплект / набор") or
// a consumer box ("Потребительская коробка"). It selects WHICH of the category's
// Tasnif package codes fiscalizes the item, so the forms are named explicitly rather
// than implied by the order codes were entered in.
//
// Only stored when someone was actually ASKED (i.e. the category carries more than
// one code). A null means "not asked". The single code answers for it only on a
// category holding nothing else; anywhere else it is refused rather than assumed to
// be a piece. A stated form with no code of its own is refused too. See
// resolvePackageCode() in common/fiscal.util.ts.
enum PackageForm {
  SINGLE
  SET
  BOX
}

enum PartVehicleCategory {
  BRAKE_SYSTEM
  MAINTENANCE_AND_FLUIDS
  SUSPENSION_AND_STEERING
  ELECTRICAL_AND_LIGHTING
  ENGINE
  TRANSMISSION
  HEATING_AND_COOLING
  TUNING_AND_ACCESSORIES
}

// Market of origin of the part, inferred from the vehicle make and/or explicit
// keywords in the listing (Xitoy/Китай/China, Korea/Корея, …).
enum PartOriginRegion {
  CHINA
  EUROPE
  RUSSIA
  KOREA
  USA
  JAPAN
}

// How a listing's part number was labeled by the seller. We NEVER guess the
// type from the number itself or from the LLM — an unlabeled number stays
// UNKNOWN so both GM-number and OEM-number searches can still find it.
//   GM      → seller labeled it a GM number  (gm_number populated, oem_number null)
//   OEM     → seller labeled it an OEM number (oem_number populated, gm_number null)
//   UNKNOWN → unlabeled (Article / Part No. / bare digits) — neither field is
//             authoritative; the raw value is kept in gm_number for the unique
//             key but is searchable as both GM and OEM.
enum PartNumberType {
  GM
  OEM
  UNKNOWN
}

// External system a Stock row was imported from. A Stock with a source is a
// position in a dealer's own inventory system (e.g. one nomenclature line in
// Driver's Village 1C), identified there by `Stock.sourceCode`. NULL means the
// listing was created in Mator itself (Telegram wizard) — every pre-existing
// row. Additive: a new integration adds one value here.
enum StockSourceSystem {
  DRIVERS_VILLAGE_1C
}

// Product-creation draft lifecycle (Telegram wizard). Two independent axes:
//   • DraftStatus         — the FORM axis (coarse, user-facing / rendezvous gate).
//   • DraftImageStatus    — the per-image USER axis (coarse; gates the rendezvous).
//   • ImageProcessingStage — the per-image TECHNICAL axis (fine; observability only,
//                            never gates business logic). New pipeline steps
//                            (moderation, thumbnails, …) slot in here as new stages.
enum DraftStatus {
  CREATING
  READY_FOR_PREVIEW
  // Claimed by a commit that is writing the product rows. Short-lived and NOT
  // terminal: it exists so the confirm path can take an exclusive claim BEFORE the
  // product write (blocking a double-tap) without lying about the outcome — a crash
  // mid-write leaves COMMITTING, which is recoverable, rather than PUBLISHED with no
  // product. The sweep collects it only once `expiresAt` has passed, so an
  // interrupted commit reclaims its assets instead of leaking them.
  COMMITTING
  PUBLISHED
  CANCELLED
  EXPIRED
}

enum DraftImageStatus {
  PROCESSING
  READY
  FAILED
}

enum ImageProcessingStage {
  QUEUED
  INGESTING_ORIGINAL
  ENHANCING
  UPLOADING_RESULT
  DONE
  FAILED
}

enum BookingStatus {
  HOLD
  CONFIRMED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  EXPIRED
}

enum DeliveryMethod {
  COURIER
  PICKUP
}

// How the customer chose to pay at checkout. PAYME = online (Payme), CASH =
// cash on delivery, TERMINAL = card reader the courier brings. Recorded on the
// order so the payment webhook and reporting know the intended method.
enum PaymentType {
  PAYME
  TERMINAL
  CASH
}

// Who performed an order status change, recorded on each OrderStatusHistory row.
// SYSTEM covers automated transitions (order creation, payment webhooks); the
// remaining values map to the acting AppUser's role at write time.
enum OrderActorType {
  SYSTEM
  CUSTOMER
  OPERATOR
  ADMIN
}

enum PaymentProvider {
  PAYME
  CLICK
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum DevicePlatform {
  IOS
  ANDROID
}

enum NotificationType {
  ORDER_PAID
  ORDER_STATUS_CHANGED
  PAYMENT_PAID
  AI_REPLY
  MASTER_MESSAGE
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  VEHICLE_STATUS_UPDATED
  MYID_VERIFIED
  MARKETING
  SOURCING_OFFER
  SOURCING_STATUS
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ── Internal marketplace (supply-side, Int PKs, NOT exposed to buyer app) ─────
model Seller {
  id              Int          @id @default(autoincrement())
  // TELEGRAM for every pre-existing row and every bot onboarding (the default);
  // BUSINESS for an integration-fed organization. See SellerType.
  sellerType      SellerType   @default(TELEGRAM) @map("seller_type")
  // Telegram user id. Still UNIQUE; NULL only for a BUSINESS seller (the CHECK
  // constraint keeps it NOT NULL for TELEGRAM sellers). PostgreSQL treats NULLs
  // as distinct, so any number of business sellers can coexist.
  tgId            BigInt?      @unique @map("tg_id")
  // Contact phone. Required for TELEGRAM sellers (same CHECK constraint);
  // optional for a BUSINESS seller.
  phone           String?      @db.VarChar(20)
  storeName       String?      @map("store_name") @db.VarChar(100)
  marketName      String?      @map("market_name") @db.VarChar(100)
  addressComment  String?      @map("address_comment")
  locationLat     Float?       @map("location_lat")
  locationLng     Float?       @map("location_lng")
  status          SellerStatus @default(PENDING)
  // Bot interface language. NULLABLE on purpose: null means "never chose one",
  // which is precisely what makes /start show the language picker exactly once.
  // A default would erase that distinction and the picker could never fire.
  lang            BotLanguage? @map("lang")
  // Explicit link to the buyer-facing CatalogSeller this supply-side seller's
  // listings are projected into. NULL (every Telegram seller) keeps the default
  // projection target `seller_<id>`. Set by an operator — never inferred — for
  // a dealer that already exists as a curated CatalogSeller (e.g.
  // 'drivers-village'), so its imported stock lands under that dealer instead
  // of a second, synthetic `seller_<id>` storefront. Plain id, no FK: the two
  // bounded contexts share no foreign keys (see CatalogProjectionService).
  // Unique so one catalog dealer is fed by at most one supply-side seller.
  catalogSellerId String?      @unique @map("catalog_seller_id") @db.VarChar(64)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  stocks          Stock[]

  @@index([status])
  @@map("sellers")
}

model Brand {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.VarChar(100)
  models    CarModel[]
  partMakes PartMake[]

  @@map("brands")
}

model CarModel {
  id         Int         @id @default(autoincrement())
  brandId    Int         @map("brand_id")
  name       String      @db.VarChar(100)
  brand      Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  partModels PartModel[]

  @@unique([brandId, name])
  @@map("car_models")
}

model Product {
  id                 Int                  @id @default(autoincrement())
  // Which questionnaire produced this listing and which attribute columns are
  // meaningful for it. SPARE_PART (the default) keeps every existing row — and
  // every existing query — behaving exactly as before.
  kind               ProductKind          @default(SPARE_PART)
  // Raw part number as written by the seller. Kept as the unique idempotency key
  // for the Telegram upsert (a synthetic key is used when the listing has none).
  // The AUTHORITATIVE OEM value lives in `oemNumber`; this column is NOT copied
  // into it. See `partNumberType` for how the seller labeled the number.
  gmNumber           String?              @unique @map("gm_number") @db.VarChar(50)
  // OEM number ONLY when the seller explicitly labeled the number as OEM. Never
  // auto-filled from gmNumber, never inferred from the number or the LLM.
  oemNumber          String?              @map("oem_number") @db.VarChar(50)
  // Whether the seller labeled the number GM, OEM, or left it unlabeled (UNKNOWN).
  partNumberType     PartNumberType       @default(UNKNOWN) @map("part_number_type")
  // Multi-valued, EXPLICITLY LABELED part numbers from a source import (e.g.
  // Driver's Village 1C). Stored in the normalizeOem canonical form, deduped.
  // Separate from `gmNumber` above on purpose: that column is the Telegram
  // upsert key and globally unique, while one GM/OEM number legitimately
  // appears on several independent dealer positions (different brands,
  // batches, prices). Imported products therefore leave `gmNumber` NULL, which
  // also guarantees the Telegram wizard can never upsert into them. Never
  // cross-copied: a GM number is never written into `oemNumbers` or vice versa.
  // The projection unions these into CatalogPart.gmNumbers / oemNumbers.
  gmNumbers          String[]             @default([]) @map("gm_numbers")
  oemNumbers         String[]             @default([]) @map("oem_numbers")
  // The part-number cell of a source import EXACTLY as the file holds it — one
  // string, never split, normalized, trimmed or case-changed (Driver's Village:
  // `manufacturer_part_number`, which may mix Cyrillic, Latin, spaces and
  // punctuation). `oemNumbers` above is only the search index derived from it.
  // NULL for Telegram listings and for an empty source cell.
  sourcePartNumber   String?              @map("source_part_number")
  title              String               @db.VarChar(255)
  description        String?              @db.Text
  imageUrl           String?              @map("image_url") // primary image mirror (back-compat)
  // Fits every vehicle. Fitment is otherwise derived from part_models rows:
  // isUniversal=false + 1 row → SINGLE, N rows → MULTIPLE; when true there are
  // no part_models rows for the product.
  isUniversal        Boolean              @default(false) @map("is_universal")
  // Classified by the Telegram bot from title + description (RU/UZ/EN). Nullable
  // so pre-classification rows stay valid; the classifier always assigns a
  // main/vehicle category (fallback when unsure), and the region/flags when
  // inferable. Projected verbatim into catalog_parts for buyer-side filtering.
  mainCategory       PartMainCategory?    @map("main_category")
  vehicleCategory    PartVehicleCategory? @map("vehicle_category")
  partBrand          String?              @map("part_brand") @db.VarChar(120)
  originRegion       PartOriginRegion?    @map("origin_region")
  isOem              Boolean              @default(false) @map("is_oem")
  isGm               Boolean              @default(false) @map("is_gm")
  // ── MOTOR_OIL attributes (null for every other kind) ──────────────────────
  // Nullable rather than a separate table: these are a handful of scalar
  // attributes on the same listing, read on every product page, and each kind
  // owns a disjoint set of them. A future kind adds its own nullable columns
  // here in the same way, gated by `kind`.
  // SAE grade as displayed, e.g. "5W-30". Free-form (the wizard offers a preset
  // list plus "Другое"), so it is a string, not an enum.
  oilViscosity       String?              @map("oil_viscosity") @db.VarChar(20)
  oilType            OilType?             @map("oil_type")
  // Package volume in MILLILITRES (integer) — stored as a number, not "4 л", so
  // it sorts and filters correctly; the display label is derived at render time.
  oilVolumeMl        Int?                 @map("oil_volume_ml")
  // ── ANTIFREEZE attributes (null for every other kind) ─────────────────────
  // NET WEIGHT in GRAMS (integer), because antifreeze is sold BY WEIGHT, not by
  // the piece: "2.5 кг" is stored as 2500. Grams — not a fractional kilogram —
  // for exactly the reason oilVolumeMl is millilitres: an integer sorts, filters
  // and compares exactly, and the "2.5 кг" label is derived at render time.
  antifreezeWeightG  Int?                 @map("antifreeze_weight_g")
  // ── Dynamic category tree (the source of truth going forward) ─────────────
  // `vehicleCategoryId` is the ROOT (level 0) node, `categoryId` the precise node
  // the seller picked (level 1 main category, or level 2 subcategory when the
  // main category has children). Both nullable: pre-migration rows and kinds
  // whose taxonomy follows from the kind itself (MOTOR_OIL) carry neither.
  //
  // The `mainCategory` / `vehicleCategory` enums above are DELIBERATELY kept and
  // still written alongside these ids — the classifier, the buyer projection and
  // the public `?main_category=` filter all still read them. They are the legacy
  // mirror; these ids are authoritative. Removing the enums is a separate,
  // later stage once every consumer reads ids.
  vehicleCategoryId  String?              @map("vehicle_category_id") @db.VarChar(64)
  categoryId         String?              @map("category_id") @db.VarChar(64)
  // The sale form the seller chose for THIS listing (see PackageForm). It is the
  // only fiscal fact a product owns: the codes themselves stay on the category,
  // so this column selects one of them rather than copying it. Null when the
  // question was never asked, which the single code answers only on a category
  // holding no other (see resolvePackageCode).
  packageForm        PackageForm?         @map("package_form")
  // ── Curated rating (admin-maintained; NOT user reviews) ───────────────────
  // There is no review subsystem: operators set these by hand in the admin
  // console and they are projected verbatim into catalog_parts. Decimal(2,1)
  // holds exactly one decimal place over 0.0–5.0, so the stored value is the
  // displayed value — no rounding at read time.
  //
  // NULL means "no rating" (render no stars), which is distinct from 0.0 ("rated
  // zero"); that is why the column is nullable rather than defaulting to 0.
  // The 0–5 bound is enforced by the admin DTO (the only writer); the column's
  // scale is what makes a second decimal place unstorable.
  ratingAvg          Decimal?             @map("rating_avg") @db.Decimal(2, 1)
  // Number of ratings behind ratingAvg, shown as "(123)" next to the stars.
  // Non-null with a 0 default: "no reviews yet" is 0, never unknown.
  reviewCount        Int                  @default(0) @map("review_count")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  partModels         PartModel[]
  // "Fits every model of this make" (make-wide compatibility), distinct from
  // both `isUniversal` (every vehicle) and part_models (specific models).
  partMakes          PartMake[]
  stocks             Stock[]
  images             ProductImage[]
  // SetNull, not Restrict: a category the admin removes must never make an
  // existing listing unreadable. Admin delete already reassigns/blocks by policy.
  categoryRef        PartCategory?        @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  vehicleCategoryRef PartCategory?        @relation("ProductVehicleCategory", fields: [vehicleCategoryId], references: [id], onDelete: SetNull)

  @@index([mainCategory])
  @@index([vehicleCategory])
  @@index([kind])
  @@index([categoryId])
  @@index([vehicleCategoryId])
  @@map("products")
}

// Ordered gallery for a product (Telegram media-group uploads). The first image
// (sortOrder 0 / isPrimary) mirrors into Product.imageUrl for legacy readers.
model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model PartModel {
  partId  Int      @map("part_id")
  modelId Int      @map("model_id")
  model   CarModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  part    Product  @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@id([partId, modelId])
  @@index([modelId])
  @@map("part_models")
}

// Make-wide compatibility: the part fits EVERY model of this brand (e.g. a
// Driver's Village row with vehicle_make = CHEVROLET and no model). A third
// fitment state next to part_models (specific models) and Product.isUniversal
// (every vehicle); a product with part_makes rows has isUniversal = false.
// Projected into catalog_part_make_fits.
model PartMake {
  partId  Int     @map("part_id")
  brandId Int     @map("brand_id")
  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  part    Product @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@id([partId, brandId])
  @@index([brandId])
  @@map("part_makes")
}

// Verified internal OEM → vehicle compatibility. This is the ONLY source from
// which an OEM number may contribute make/model to a listing. It is populated
// MANUALLY over time (starts empty); the parser NEVER writes rows here and NEVER
// infers compatibility from the number itself or from the LLM. One OEM number
// can fit several vehicles, so oemNumber is intentionally NOT unique — one row
// per (oemNumber, make, model). No match → no compatibility.
model OemCompatibility {
  id        Int      @id @default(autoincrement())
  oemNumber String   @map("oem_number") @db.VarChar(50)
  make      String   @db.VarChar(120)
  model     String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([oemNumber, make, model])
  @@index([oemNumber])
  @@map("oem_compatibility")
}

model Stock {
  id           Int                @id @default(autoincrement())
  sellerId     Int                @map("seller_id")
  productId    Int                @map("product_id")
  // Price per `unit` in UZS. For an imported position this is the source
  // file's price verbatim (no markup or conversion), projected unchanged into
  // CatalogPart.priceUzs.
  priceUzs     Decimal            @map("price_uzs") @db.Decimal(14, 2)
  // On-hand quantity, counted in `unit`. Imported positions must be whole
  // numbers — the importer rejects a fractional quantity rather than rounding.
  quantity     Int                @default(1)
  // Unit `quantity` and `priceUzs` refer to: 'PCS' (штука) or 'L' (литр) — the
  // same codes as KindCapabilities.unit. NULL for Telegram listings, whose unit
  // follows from the product kind.
  unit         String?            @db.VarChar(16)
  // Identity of this position in the external system it was imported from.
  // Both NULL for Telegram listings. `sourceCode` is the external system's own
  // position id (Driver's Village: code_1c) — NOT a part number, and never
  // written into Product.gmNumber.
  sourceSystem StockSourceSystem? @map("source_system")
  sourceCode   String?            @map("source_code") @db.VarChar(64)
  // Set with a 1C price or quantity write, cleared once the catalog part has it. Holds, per
  // column, what the part held before, so a later repair can tell a projection that never
  // ran from a value an administrator set: see drivers-village.planner.ts. NULL otherwise.
  projectionPending Json?         @map("projection_pending")
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  product      Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  seller       Seller             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  reservations InventoryReservation[]

  @@unique([sellerId, productId])
  // Idempotency key of an imported position: re-importing the same code_1c
  // updates this row instead of creating another. NULLs are distinct in a
  // PostgreSQL unique index, so Telegram listings (no source) never collide.
  @@unique([sellerId, sourceSystem, sourceCode])
  @@index([productId])
  @@map("stocks")
}

// Intermediate draft for the Telegram product-creation wizard. Lets image
// processing (BullMQ) run in PARALLEL with the seller filling the questionnaire,
// so the seller never idles waiting for FLUX. The published Product/Stock/
// ProductImage rows are still written exactly as before on confirmation — this
// table only holds the in-progress state.
//
// sellerId is a plain column (supply-side Int PK, like Stock.sellerId) — a draft
// is ephemeral, so no FK cascade is modeled here. `status`+`version` implement an
// optimistic lock for safe coordination between the Telegram thread, the N image
// workers, and the TTL sweep. `expiresAt` is the single (DB-visible) TTL.
model ProductDraft {
  id                 String               @id // prefixedId(IdPrefix.DRAFT)
  sellerId           Int                  @map("seller_id")
  tgId               BigInt               @map("tg_id") // == Telegram chat id (out-of-band notify)
  status             DraftStatus          @default(CREATING)
  version            Int                  @default(0) // optimistic lock: bumped on every status transition
  formStep           String               @map("form_step") // WizardStep name → resumable FSM
  // Which questionnaire this draft is running. Chosen at the BRAND step ("Другое"
  // → a non-spare-part category) and carried into the published Product.
  kind               ProductKind          @default(SPARE_PART)
  brand              String?
  model              String?
  category           PartVehicleCategory?
  // The subcategory chosen under `category`, for the main categories that have
  // them. Null for a category with no subcategories (TRANSMISSION,
  // HEATING_AND_COOLING) and for kinds that never ask a category — so it is NOT
  // a completeness requirement on its own; the wizard flow enforces the answer
  // where the question is asked.
  subcategory        PartMainCategory?
  title              String?              @db.VarChar(255)
  description        String?              @db.Text
  partNumberType     PartNumberType       @default(UNKNOWN) @map("part_number_type")
  partNumber         String?              @map("part_number") @db.VarChar(50)
  // MOTOR_OIL attributes — mirror the Product columns (see there); null for
  // every other kind. The draft holds them so a resumed/edited flow loses nothing.
  oilViscosity       String?              @map("oil_viscosity") @db.VarChar(20)
  oilType            OilType?             @map("oil_type")
  oilVolumeMl        Int?                 @map("oil_volume_ml")
  // ANTIFREEZE attribute — mirrors the Product column (see there): NET WEIGHT in
  // GRAMS, null for every other kind.
  antifreezeWeightG  Int?                 @map("antifreeze_weight_g")
  priceUzs           Decimal?             @map("price_uzs") @db.Decimal(14, 2)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  expiresAt          DateTime             @map("expires_at") @db.Timestamptz(3) // TTL sweep
  // Delivery metadata (NOT a business state): set once, atomically, by whichever
  // candidate (worker's ready-for-preview event OR /start recovery) first sends the
  // preview — a compare-and-set on `previewSentAt IS NULL` that makes exactly one
  // send win, so two racing sends can't both storePending (which would delete each
  // other's Cloudinary assets). `status` stays READY_FOR_PREVIEW.
  previewSentAt      DateTime?            @map("preview_sent_at") @db.Timestamptz(3)
  // ── Dynamic category tree — the seller's EXACT choice, preserved verbatim ──
  // Mirrors the Product columns (see there) and is copied into them on commit.
  // The legacy `category` / `subcategory` enum columns above are still written
  // alongside these ids during the compatibility stage.
  vehicleCategoryId  String?              @map("vehicle_category_id") @db.VarChar(64)
  categoryId         String?              @map("category_id") @db.VarChar(64)
  // The sale form answered at the PACKAGE_FORM step, mirroring the Product
  // column (see there) and copied into it on commit. Null while unanswered — and
  // permanently so for a category that offers only one package code, whose
  // seller is never asked. Cleared whenever the chosen category changes.
  packageForm        PackageForm?         @map("package_form")
  // PHOTO-UPDATE draft: the existing Stock whose product gallery these images
  // will replace on confirm (a Driver's Village position addressed by its
  // code_1c). NULL for every ordinary listing draft. A photo-update draft runs
  // the same image pipeline and preview, but has no questionnaire and never
  // creates a Product or Stock. Plain id, no FK — a draft is ephemeral, and the
  // confirm path re-validates the stock's identity before writing.
  targetStockId      Int?                 @map("target_stock_id")
  images             ProductDraftImage[]
  categoryRef        PartCategory?        @relation("ProductDraftCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  vehicleCategoryRef PartCategory?        @relation("ProductDraftVehicleCategory", fields: [vehicleCategoryId], references: [id], onDelete: SetNull)

  @@index([sellerId, status]) // "resumable draft for this seller"
  @@index([targetStockId])
  @@index([expiresAt]) // cleanup sweep
  @@index([categoryId])
  @@index([vehicleCategoryId])
  @@map("product_drafts")
}

// One row per uploaded photo of a draft. Two state axes:
//   • status — USER-facing (PROCESSING/READY/FAILED); the rendezvous reads ONLY this.
//   • stage  — TECHNICAL (QUEUED…DONE/FAILED); written as the worker advances, for
//              logging/monitoring. Derived invariant kept by the worker:
//              DONE⇔READY, FAILED⇔FAILED, any intermediate stage ⇒ PROCESSING.
// The worker is two-phase & phase-idempotent: phase A (ingest) fetches the Telegram
// file and stores the ORIGINAL in Cloudinary (originalUrl); phase B (enhance) runs
// FLUX and stores the PROCESSED result. Retry keys off originalUrl (data), so a
// re-run skips phase A and never re-touches Telegram. Each row has a single writer
// (its own worker job), so it needs no version column.
model ProductDraftImage {
  id                String               @id // prefixedId(IdPrefix.DRAFT_IMAGE)
  draftId           String               @map("draft_id")
  sortOrder         Int                  @map("sort_order") // album order, independent of completion order
  status            DraftImageStatus     @default(PROCESSING) // USER axis (gates rendezvous)
  stage             ImageProcessingStage @default(QUEUED) // TECH axis (observability only)
  tgFileId          String               @map("tg_file_id") // stored on upload; worker phase A source
  originalUrl       String?              @map("original_url") // filled by phase A; reused on retries
  originalPublicId  String?              @map("original_public_id")
  processedUrl      String?              @map("processed_url") // filled by phase B
  processedPublicId String?              @map("processed_public_id")
  jobId             String?              @map("job_id") // BullMQ job id (image:<draftId>:<imageId>)
  attempts          Int                  @default(0)
  lastError         String?              @map("last_error") @db.Text
  draft             ProductDraft         @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, sortOrder])
  @@map("product_draft_images")
}

// ── Buyer identity (UUID) ─────────────────────────────────────────────────────
model AppUser {
  id                  String     @id @default(uuid()) @db.Uuid
  email               String?    @unique @db.VarChar(255)
  passwordHash        String?    @map("password_hash") @db.VarChar(255)
  emailVerified       Boolean    @default(false) @map("email_verified")
  phoneE164           String?    @unique @map("phone_e164") @db.VarChar(20)
  phoneVerified       Boolean    @default(false) @map("phone_verified")
  displayName         String?    @map("display_name") @db.VarChar(120)
  firstName           String?    @map("first_name") @db.VarChar(100)
  lastName            String?    @map("last_name") @db.VarChar(100)
  avatarUrl           String?    @map("avatar_url")
  // Cloudinary public_id of the CURRENT avatar, stored at upload time. Deleting
  // the asset needs this id, and deriving it from the secure URL is fragile and
  // wrong in general (version segments, folders, transformations, and a format
  // suffix that is not part of the id). Storing what the upload response already
  // returned — the same `publicId` the draft-image pipeline persists — makes
  // avatar cleanup exact instead of a guess. Null for avatars uploaded before
  // this column existed, and for users with no avatar.
  avatarPublicId      String?    @map("avatar_public_id")
  thumbnailUrl        String?    @map("thumbnail_url")
  role                Role       @default(USER)
  language            Language   @default(UZ)
  myIdStatus          MyIdStatus @default(NOT_VERIFIED) @map("myid_status")
  transactionLimitUzs Decimal    @default(0) @map("transaction_limit_uzs") @db.Decimal(14, 2)
  // Session version: every access token carries the value it was signed with;
  // bumping it invalidates all outstanding access tokens on the next request.
  tokenVersion        Int        @default(0) @map("token_version")
  // Account deletion (DELETE /v1/me — an App Store requirement). The row is NOT
  // dropped: orders reference it with onDelete: Restrict and must be retained
  // for financial/legal records. Instead every personal field on it is
  // irreversibly overwritten and this timestamp is set.
  //
  // It is the AUTHORITATIVE "this account is gone" flag: JwtStrategy rejects any
  // token whose user carries it, so a deleted account can never authenticate
  // again even though the row survives. Null for every live account.
  deletedAt           DateTime?  @map("deleted_at") @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens          RefreshToken[]
  identities             AuthIdentity[]
  emailTokens            EmailVerificationToken[]
  vehicles               Vehicle[]
  orders                 Order[]
  bookings               Booking[]
  cart                   Cart?
  devices                Device[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  aiSessions             AiSession[]
  addresses              Address[]
  myIdSessions           MyIdSession[]
  myIdVerifications      MyIdVerification[]
  legalAcceptances       LegalAcceptance[]

  sourcingRequests SourcingRequest[]
  orderIdempotency OrderIdempotency[]

  @@index([deletedAt])
  @@map("app_users")
}

model AuthIdentity {
  id             Int          @id @default(autoincrement())
  provider       AuthProvider
  providerUserId String       @map("provider_user_id") @db.VarChar(255)
  email          String?      @db.VarChar(255)
  userId         String       @map("user_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           AppUser      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model RefreshToken {
  id           Int       @id @default(autoincrement())
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  userId       String    @map("user_id") @db.Uuid
  deviceId     String?   @map("device_id") @db.VarChar(64) // session<->device binding; null for web/email logins
  // Session version this token was minted under. Rotation refuses a row whose
  // version no longer matches the account, so a refresh token created in the
  // race window of a revocation cannot revive the session it belonged to.
  tokenVersion Int       @default(0) @map("token_version")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(3) // soft-rotation marker for reuse detection
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user         AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device       Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@index([deviceId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id         Int       @id @default(autoincrement())
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  userId     String    @map("user_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user       AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

// Phone OTP (pre-auth; not yet linked to a user). request_id = otp_<ulid>.
model PhoneOtpRequest {
  id          String     @id @db.VarChar(64)
  phoneE164   String     @map("phone_e164") @db.VarChar(20)
  codeHash    String     @map("code_hash") @db.VarChar(64)
  channel     OtpChannel @default(SMS)
  purpose     String     @default("login") @db.VarChar(40)
  attempts    Int        @default(0)
  resendCount Int        @default(0) @map("resend_count")
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime?  @map("consumed_at") @db.Timestamptz(3)
  lastSentAt  DateTime   @default(now()) @map("last_sent_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phoneE164, createdAt]) // supports "N per hour per MSISDN" rate-limit counting
  @@index([expiresAt])
  @@map("phone_otp_requests")
}

// MyID OAuth verification session (myid_sess_<ulid>).
model MyIdSession {
  id                  String   @id @db.VarChar(64)
  userId              String   @map("user_id") @db.Uuid
  state               String   @unique @db.VarChar(120)
  codeChallenge       String   @map("code_challenge") @db.VarChar(255)
  codeChallengeMethod String   @default("S256") @map("code_challenge_method") @db.VarChar(10)
  codeVerifier        String?  @map("code_verifier") @db.VarChar(255) // only set for backend-generated PKCE fallback
  scopes              String[]
  redirectUri         String   @map("redirect_uri")
  status              String   @default("pending") @db.VarChar(20)
  expiresAt           DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user                AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("myid_sessions")
}

// Resolved MyID identity payload (myid_ver_<ulid>).
model MyIdVerification {
  id                  String    @id @db.VarChar(64)
  userId              String    @map("user_id") @db.Uuid
  sessionId           String?   @map("session_id") @db.VarChar(64)
  status              String    @db.VarChar(20)
  pinfl               String?   @db.VarChar(14)
  passportSerial      String?   @map("passport_serial") @db.VarChar(2)
  passportNumber      String?   @map("passport_number") @db.VarChar(20)
  firstName           String?   @map("first_name") @db.VarChar(100)
  lastName            String?   @map("last_name") @db.VarChar(100)
  middleName          String?   @map("middle_name") @db.VarChar(100)
  dateOfBirth         DateTime? @map("date_of_birth") @db.Date
  gender              Gender?
  citizenshipIso3     String?   @map("citizenship_iso3") @db.VarChar(3)
  addressRegion       String?   @map("address_region") @db.VarChar(120)
  addressDistrict     String?   @map("address_district") @db.VarChar(120)
  addressStreet       String?   @map("address_street")
  biometricMatchScore Decimal?  @map("biometric_match_score") @db.Decimal(4, 3)
  verifiedAt          DateTime? @map("verified_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user                AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pinfl])
  @@map("myid_verifications")
}

model Address {
  id         String   @id @db.VarChar(64)
  userId     String   @map("user_id") @db.Uuid
  label      String?  @db.VarChar(80)
  regionCode String?  @map("region_code") @db.VarChar(10)
  district   String?  @db.VarChar(120)
  street     String?
  fullText   String   @map("full_text")
  // A readable hint for the courier. A map pin needs no street address, so this may be
  // the only words a destination has.
  landmark   String?  @db.VarChar(200)
  lat        Float?
  lng        Float?
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user       AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([userId])
  @@map("addresses")
}

// ── Vehicle catalog (buyer garage reference, slug IDs) ────────────────────────
model VehicleMake {
  id         String                  @id @db.VarChar(64)
  name       String                  @db.VarChar(120)
  logoUrl    String?                 @map("logo_url")
  sortOrder  Int                     @default(0) @map("sort_order")
  country    String?                 @map("country") @db.VarChar(80)
  isActive   Boolean                 @default(true) @map("is_active")
  comingSoon Boolean                 @default(false) @map("coming_soon")
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")
  models     VehicleModelRef[]
  vehicles   Vehicle[]
  providers  ProviderSupportedMake[]

  @@map("vehicle_makes")
}

model VehicleModelRef {
  id              String           @id @db.VarChar(64)
  makeId          String           @map("make_id") @db.VarChar(64)
  name            String           @db.VarChar(120)
  sortOrder       Int              @default(0) @map("sort_order")
  yearFrom        Int?             @map("year_from")
  yearTo          Int?             @map("year_to")
  bodyType        String?          @map("body_type") @db.VarChar(60)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  make            VehicleMake      @relation(fields: [makeId], references: [id], onDelete: Cascade)
  trims           VehicleTrim[]
  vehicles        Vehicle[]
  fitmentBindings FitmentBinding[]

  @@index([makeId])
  @@map("vehicle_models")
}

model VehicleTrim {
  id              String              @id @db.VarChar(64)
  modelId         String              @map("model_id") @db.VarChar(64)
  name            String              @db.VarChar(120)
  sortOrder       Int                 @default(0) @map("sort_order")
  model           VehicleModelRef     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  vehicles        Vehicle[]
  assets          Vehicle3dAsset[]
  compatibilities PartCompatibility[]

  @@index([modelId])
  @@map("vehicle_trims")
}

model VehicleEngine {
  id              String              @id @db.VarChar(64)
  name            String              @db.VarChar(120)
  displacementCc  Int?                @map("displacement_cc")
  fuelType        FuelType?           @map("fuel_type")
  sortOrder       Int                 @default(0) @map("sort_order")
  vehicles        Vehicle[]
  compatibilities PartCompatibility[]

  @@map("vehicle_engines")
}

model Vehicle3dAsset {
  id              String          @id @db.VarChar(64)
  trimId          String?         @map("trim_id") @db.VarChar(64)
  glbUrl          String          @map("glb_url")
  ktx2TexturesUrl String?         @map("ktx2_textures_url")
  version         Int             @default(1)
  byteSize        Int?            @map("byte_size")
  checksumSha256  String?         @map("checksum_sha256") @db.VarChar(64)
  trim            VehicleTrim?    @relation(fields: [trimId], references: [id], onDelete: SetNull)
  variants        TuningVariant[]
  vehicles        Vehicle[]

  @@index([trimId])
  @@map("vehicle_3d_assets")
}

model TuningVariant {
  id           String         @id @db.VarChar(64)
  assetId      String         @map("asset_id") @db.VarChar(64)
  name         String         @db.VarChar(120)
  thumbnailUrl String?        @map("thumbnail_url")
  asset        Vehicle3dAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("tuning_variants")
}

// ── User vehicles (veh_<ulid>) ────────────────────────────────────────────────
model Vehicle {
  id                     String               @id @db.VarChar(64)
  userId                 String               @map("user_id") @db.Uuid
  isPrimary              Boolean              @default(false) @map("is_primary")
  nickname               String?              @db.VarChar(120)
  makeId                 String               @map("make_id") @db.VarChar(64)
  modelId                String               @map("model_id") @db.VarChar(64)
  year                   Int
  trimId                 String?              @map("trim_id") @db.VarChar(64)
  engineId               String?              @map("engine_id") @db.VarChar(64)
  transmission           VehicleTransmission?
  drivetrain             Drivetrain?
  colorHex               String?              @map("color_hex") @db.VarChar(9)
  vin                    String?              @db.VarChar(50)
  licensePlate           String?              @map("license_plate") @db.VarChar(20)
  registrationRegionCode String?              @map("registration_region_code") @db.VarChar(10)
  mileageKm              Int?                 @map("mileage_km")
  fuelType               FuelType?            @map("fuel_type")
  model3dAssetId         String?              @map("model_3d_asset_id") @db.VarChar(64)
  /// Canonical vehicle-image identity (SHA-256 hex) this vehicle shows; null for
  /// vehicles created before Phase 3E, while the integration is off, or under review.
  imageIdentityKey       String?              @map("image_identity_key") @db.Char(64)
  /// Set when the identity was ambiguous: the vehicle keeps the placeholder and is
  /// flagged for review (see vehicle-image.identity.ts IMAGE_REVIEW_REASONS).
  imageReviewReason      String?              @map("image_review_reason") @db.VarChar(64)
  deletedAt              DateTime?            @map("deleted_at") @db.Timestamptz(3)
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         AppUser              @relation(fields: [userId], references: [id], onDelete: Cascade)
  make         VehicleMake          @relation(fields: [makeId], references: [id], onDelete: Restrict)
  model        VehicleModelRef      @relation(fields: [modelId], references: [id], onDelete: Restrict)
  trim         VehicleTrim?         @relation(fields: [trimId], references: [id], onDelete: SetNull)
  engine       VehicleEngine?       @relation(fields: [engineId], references: [id], onDelete: SetNull)
  model3dAsset Vehicle3dAsset?      @relation(fields: [model3dAssetId], references: [id], onDelete: SetNull)
  imageIdentity VehicleImageIdentity? @relation(fields: [imageIdentityKey], references: [identityKey], onDelete: SetNull)
  bookings     Booking[]
  aiSessions   AiSession[]
  orders       Order[]
  statusEvents VehicleStatusEvent[]

  @@index([userId])
  @@index([userId, isPrimary])
  @@index([imageIdentityKey])
  @@index([imageReviewReason])
  @@map("vehicles")
}

// ── Vehicle images (Phase 3E: Garage ↔ Vehicle Image Pipeline) ────────────────
enum VehicleImageStatus {
  PENDING
  APPROVED
  UNAVAILABLE
}

enum VehicleImageOutboxStatus {
  PENDING
  DISPATCHED
  DEAD
}

/// Local copy of the pipeline's state for one canonical identity, shared by every
/// Garage vehicle with that identity. The pipeline stays the source of truth; this
/// row is what Garage responses read, so they never wait on the pipeline.
model VehicleImageIdentity {
  /// SHA-256 hex of the canonical tuple: the pipeline's `identityKey`.
  identityKey       String               @id @map("identity_key") @db.Char(64)
  /// The exact 7-field canonical identity sent to the pipeline.
  identity          Json
  /// Display facts sent with it ({manufacturer, model, trim?}).
  display           Json
  status            VehicleImageStatus   @default(PENDING)
  reason            String?              @db.VarChar(64)
  pipelineStatus    String?              @map("pipeline_status") @db.VarChar(32)
  pipelineRequestId String?              @map("pipeline_request_id") @db.VarChar(64)
  /// Published (public HTTPS) URL and version; set only once approved and published.
  imageUrl          String?              @map("image_url") @db.VarChar(2048)
  imageVersion      Int?                 @map("image_version")
  lastSyncedAt      DateTime?            @map("last_synced_at") @db.Timestamptz(3)
  nextSyncAt        DateTime?            @map("next_sync_at") @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  vehicles          Vehicle[]
  outbox            VehicleImageOutbox[]

  @@index([nextSyncAt])
  @@map("vehicle_image_identities")
}

/// Transactional outbox: a row is written in the SAME transaction as the Garage
/// vehicle, and the vehicle-images queue delivers it to the pipeline afterwards.
/// At most one PENDING row per identity: a partial unique index the migration
/// adds by hand (Prisma cannot express it).
model VehicleImageOutbox {
  id           String                   @id @db.VarChar(64)
  identityKey  String                   @map("identity_key") @db.Char(64)
  status       VehicleImageOutboxStatus @default(PENDING)
  /// Delivery attempts started; also part of the BullMQ jobId, so each attempt is claimed once.
