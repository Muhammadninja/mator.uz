// ── SMS accounting & operator pricing ─────────────────────────────────────────
// Additive analytics layer around the EXISTING SMS send path — no existing table,
// endpoint, provider, or the SmsProvider interface is touched. An SmsMessage row
// is written at send time with status='pending'; a future delivery callback (not
// yet implemented) flips status→delivered/failed and fills delivered_at, so no
// schema change is needed to add delivery tracking later.

model SmsOperator {
  id          Int                 @id @default(autoincrement())
  // Canonical, stable key (e.g. "beeline"); snapshotted onto SmsMessage.operatorName.
  name        String              @unique @db.VarChar(40)
  displayName String              @map("display_name") @db.VarChar(80)
  // Current price per SMS in UZS. NEVER used to recompute historical cost — each
  // SmsMessage snapshots the price in force at send time (see SmsMessage.priceUzs).
  priceUzs    Int                 @map("price_uzs")
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  prefixes    SmsOperatorPrefix[]
  messages    SmsMessage[]

  @@map("sms_operators")
}

model SmsOperatorPrefix {
  id         Int         @id @default(autoincrement())
  operatorId Int         @map("operator_id")
  // 2-digit MSISDN operator code after the 998 country code (e.g. "90"). Globally
  // unique: a prefix maps to exactly one operator.
  prefix     String      @unique @db.VarChar(8)
  operator   SmsOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
  @@map("sms_operator_prefixes")
}

model SmsMessage {
  id                    Int          @id @default(autoincrement())
  // Transport that accepted the send (SmsProvider.name, e.g. "sayqal").
  provider              String       @db.VarChar(40)
  // Provider-returned identifiers/parts. Null at insert: the SmsProvider contract
  // returns void, so these are reserved for a later delivery callback.
  providerTransactionId String?      @map("provider_transaction_id") @db.VarChar(120)
  providerSmsId         String?      @map("provider_sms_id") @db.VarChar(120)
  phoneE164             String       @map("phone_e164") @db.VarChar(20)
  // Operator snapshot — resolved at send time and frozen. operatorName/priceUzs
  // are copies, never re-derived from SmsOperator, so historical cost is immutable
  // against later price edits. operatorId is a soft link (SET NULL on delete).
  operatorId            Int?         @map("operator_id")
  operatorName          String?      @map("operator_name") @db.VarChar(40)
  priceUzs              Int?         @map("price_uzs")
  // Optional message-template label (never the rendered text — OTP codes are not
  // persisted). Nullable for callers that don't tag their sends.
  template              String?      @db.VarChar(60)
  parts                 Int?
  // Lifecycle: 'pending' at insert → 'delivered' | 'failed' via future callback.
  status                String       @default("pending") @db.VarChar(20)
  errorCode             String?      @map("error_code") @db.VarChar(40)
  errorMessage          String?      @map("error_message") @db.Text
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  deliveredAt           DateTime?    @map("delivered_at") @db.Timestamptz(3)
  operator              SmsOperator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([operatorId])
  @@index([createdAt])
  @@index([phoneE164])
  @@map("sms_messages")
}

// ── Admin panel authentication ───────────────────────────────────────────────
// Completely separate identity space from AppUser: admins are staff accounts for
// the back-office console, log in with email + password (never OTP), and their
// tokens are signed with a different key/algorithm/audience than the mobile
// app's (see AdminTokenService). Nothing here references app_users, and the
// mobile OTP flow is untouched.

enum AdminRole {
  SUPER_ADMIN
  MANAGER
  OPERATOR
}

/// Critical, security-relevant actions on administrator accounts. Only lifecycle
/// and privilege changes belong here — routine reads are not audited.
enum AdminAuditAction {
  CREATE_ADMIN
  DEACTIVATE_ADMIN
  REACTIVATE_ADMIN
  CHANGE_ROLE
  CHANGE_PASSWORD
  RESET_PASSWORD
  DELETE_ADMIN
  // Invite-only admin signup. INVITE_ADMIN is written when a SUPER_ADMIN issues
  // an invite (target = the invited email); ACCEPT_INVITE when the invitee
  // completes signup (target = the newly created admin account).
  INVITE_ADMIN
  ACCEPT_INVITE
  // Dealer moderation (/v1/admin/dealers). The target is a dealer, not an
  // administrator, so these entries carry targetEntity/targetEntityId rather
  // than targetAdminId — see AdminAudit.
  DEALER_CERTIFIED_ENABLED
  DEALER_CERTIFIED_DISABLED
  DEALER_LOWEST_PRICE_ENABLED
  DEALER_LOWEST_PRICE_DISABLED
  DEALER_APPROVED
  DEALER_SUSPENDED
  DEALER_REACTIVATED
  DEALER_UPDATED
  // A dealer/storefront created from the admin console (POST /v1/admin/dealers).
  // The target is the new dealer; newValues carries the initial row.
  DEALER_CREATED
  // 1C integration credential lifecycle. Neither entry ever carries the key or
  // its digest — only the display suffix and the timestamps, so the audit trail
  // records WHO issued or revoked a key and WHEN without becoming a place the
  // secret can be read back out of.
  DEALER_API_KEY_ISSUED
  DEALER_API_KEY_REVOKED
  // Catalog changes (/v1/admin/categories, /v1/admin/products, /v1/admin/inventory,
  // /v1/admin/brands, /v1/admin/models). previousValues/newValues hold only what
  // changed, per target, so a price or stock edit reads as old value and new value.
  CATEGORY_DELETED
  CATEGORY_ITEMS_TRANSFERRED
  CATALOG_PART_MOVED
  INVENTORY_UPDATED
  BRAND_DELETED
  MODEL_DELETED
  // Operator order actions. The order's status history stays the record of the
  // lifecycle; these add the money side an operator is accountable for, including
  // how a payment was confirmed and what the provider's transaction said then.
  ORDER_PAYMENT_CONFIRMED
  ORDER_CANCELLED
  // Name or email of an administrator account changed (PATCH /v1/admins/:id).
  ADMIN_PROFILE_UPDATED
  REFUND_RECORDED
  REFUND_VOIDED
  // What reaches a tax receipt. The two CATEGORY_FISCAL_* values are no longer written
  // (category codes need no confirmation since 2026-11-09); they stay for the audit rows
  // already recorded. SOURCING_OFFER_CLASSIFIED: classifying a sourcing offer so it can
  // be fiscalized. newValues carries the exact codes or category.
  CATEGORY_FISCAL_CONFIRMED
  CATEGORY_FISCAL_UNCONFIRMED
  SOURCING_OFFER_CLASSIFIED
  // Money Mator sent a seller, and taking back a wrong entry of it. The target is the dealer.
  SELLER_PAYOUT_RECORDED
  SELLER_PAYOUT_VOIDED
  // Holding an order back from seller payouts while a cancellation or return is under way,
  // and releasing it. The target is the order.
  ORDER_PAYOUT_HOLD_SET
  ORDER_PAYOUT_HOLD_RELEASED
  // An operator's hand on an inventory reservation. The target is the order.
  INVENTORY_RESERVATION_RECONCILED
  INVENTORY_RESERVATION_RELEASED
  INVENTORY_RESERVATION_RESTOCKED
}

// What kind of thing an audit entry is about, for entries whose target is not
// an administrator account. Null on the admin-account actions, which keep using
// the targetAdminId FK.
enum AdminAuditEntity {
  DEALER
  CATEGORY
  CATALOG_PART
  ORDER
  BRAND
  VEHICLE_MODEL
  SOURCING_OFFER
}

model AppAdmin {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(255)
  // Bcrypt hash only — the plaintext password is never stored, logged or returned.
  passwordHash String    @map("password_hash") @db.VarChar(255)
  name         String    @db.VarChar(120)
  role         AdminRole @default(OPERATOR)
  isActive     Boolean   @default(true) @map("is_active")
  // Session version — mirrors AppUser.tokenVersion: bumping it invalidates every
  // outstanding admin access token on the next request (deactivation, password
  // change, refresh-token reuse).
  tokenVersion Int       @default(0) @map("token_version")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens   AdminRefreshToken[]
  auditsPerformed AdminAudit[]        @relation("AdminAuditActor")
  auditsReceived  AdminAudit[]        @relation("AdminAuditTarget")
  invitesSent     AdminInvite[]       @relation("AdminInviteInviter")

  @@map("app_admins")
}

/// Append-only audit trail for critical administrator actions (creation, role
/// changes, deactivation, password changes, deletion).
///
/// Two properties make this trustworthy:
///
///   • Actor and target identities are SNAPSHOTS taken at write time — like
///     OrderStatusHistory's actor columns — so an entry keeps saying WHO did
///     WHAT to WHOM even after either account is renamed or deleted.
///   • Both FKs are ON DELETE SET NULL, never CASCADE: deleting an administrator
///     must not erase the record of what they did, or of their own deletion.
///     That would let anyone destroy their own trail by removing the account.
///
/// Rows are never updated or deleted by application code.
model AdminAudit {
  id             String            @id @default(cuid())
  action         AdminAuditAction
  // Who performed it. Null only for actions with no signed-in actor — the CLI
  // bootstrap of the first SUPER_ADMIN (see actorLabel).
  actorId        String?           @map("actor_id")
  actorEmail     String?           @map("actor_email") @db.VarChar(255)
  actorName      String?           @map("actor_name") @db.VarChar(120)
  // Human-readable origin for actions with no admin actor, e.g. "cli:admin:create".
  actorLabel     String?           @map("actor_label") @db.VarChar(60)
  // Which account it was performed on.
  targetAdminId  String?           @map("target_admin_id")
  targetEmail    String?           @map("target_email") @db.VarChar(255)
  targetName     String?           @map("target_name") @db.VarChar(120)
  // Before/after for privilege changes (CHANGE_ROLE). Null for other actions.
  previousRole   AdminRole?        @map("previous_role")
  newRole        AdminRole?        @map("new_role")
  // Target for actions performed on something OTHER than an administrator
  // account — today a dealer. targetAdminId cannot carry these: it is an FK to
  // app_admins, so a dealer id would violate it. Deliberately NOT a foreign key
  // itself: the trail is append-only and must survive deletion of its subject,
  // which is also why targetName above snapshots the display name at write time.
  targetEntity   AdminAuditEntity? @map("target_entity")
  targetEntityId String?           @map("target_entity_id") @db.VarChar(64)
  // Before/after snapshot of the changed fields, e.g.
  // {"certified": false} → {"certified": true}. Only the fields the action
  // touched, never a whole row — and never a credential.
  previousValues Json?             @map("previous_values")
  newValues      Json?             @map("new_values")
  // Free-text reason supplied by the acting admin (dealer suspension).
  reason         String?           @db.VarChar(500)
  // Request provenance. Untrusted and display-only — never an authorization input.
  ip             String?           @db.VarChar(45)
  userAgent      String?           @map("user_agent") @db.VarChar(400)
  // Correlation id of the HTTP request that performed the action. Grepping the
  // server log for it returns the whole story of the incident — the HTTP entry,
  // any exception, and this audit write — with no join table.
  requestId      String?           @map("request_id") @db.VarChar(64)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  actor  AppAdmin? @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  target AppAdmin? @relation("AdminAuditTarget", fields: [targetAdminId], references: [id], onDelete: SetNull)

  @@index([targetAdminId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  // "everything that happened to this dealer", newest first.
  @@index([targetEntity, targetEntityId, createdAt])
  @@map("admin_audits")
}

// One row per SESSION, not per admin: every login creates a new row, so an admin
// signed in on a laptop, a home PC and a work PC holds three independent,
// coexisting sessions that never evict one another. The metadata columns exist
// so those sessions can be listed and revoked individually ("sign out this
// device") rather than only all at once.
model AdminRefreshToken {
  id           Int       @id @default(autoincrement())
  // SHA-256 of the opaque token; the raw value exists only in the client's hands.
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  adminId      String    @map("admin_id")
  tokenVersion Int       @default(0) @map("token_version")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  // Soft-rotation marker: a consumed row is kept so a replay is detectable as
  // reuse rather than simply "not found".
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(3)
  // Explicit single-session revocation (logout / "sign out this device"). Kept
  // distinct from consumedAt: consumed means "rotated normally", revoked means
  // "deliberately killed", and only the former is a theft signal when replayed.
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  // Session provenance, for the "active sessions" list. Client-supplied and
  // therefore untrusted — display-only, never used for an authorization
  // decision. Carried across rotation so a session keeps its identity.
  deviceName   String?   @map("device_name") @db.VarChar(120)
  ip           String?   @db.VarChar(45) // 45 = max INET6_ADDRSTRLEN
  userAgent    String?   @map("user_agent") @db.VarChar(400)
  // Refreshed on every rotation, so the list can show "last active".
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  admin        AppAdmin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_refresh_tokens")
}

/// Invite-only admin signup. A SUPER_ADMIN invites a specific email; a one-time,
/// expiring link is emailed; the invitee sets a password and their account is
/// created. Mirrors the refresh-token security posture:
///
///   • Only the SHA-256 hash of the opaque token is stored — the raw token exists
///     solely in the emailed link, so a leaked DB row cannot be turned back into
///     a usable invite.
///   • Single-use: `acceptedAt` is stamped on acceptance and a used invite is
///     never honoured again.
///   • Short-lived: `expiresAt` (48h) is checked on both preview and accept.
///
/// `invitedById` is ON DELETE SET NULL so removing the inviting admin never
/// deletes the pending invite (or its record). Rows are safe to prune after
/// expiry/acceptance but are not cascaded away with the inviter.
model AdminInvite {
  id          String    @id @default(cuid())
  email       String    @db.VarChar(255)
  // SHA-256 hex of the opaque token; the raw value lives only in the emailed link.
  tokenHash   String    @map("token_hash") @db.VarChar(64)
  role        AdminRole @default(OPERATOR)
  invitedById String?   @map("invited_by_id")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  // Stamped when the invitee sets their password; a used invite is never re-honoured.
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  invitedBy AppAdmin? @relation("AdminInviteInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([tokenHash])
  @@index([email])
  @@map("admin_invites")
}

// ── Sales (automatic discounts) ───────────────────────────────────────────────
// Entirely separate from the promo-code system (Cart.promoCode / promo.util.ts):
// a promo code is entered by the buyer and discounts a whole cart, whereas a
// sale is created in the admin panel, applies automatically with no user input,
// and discounts a PRODUCT. The two never share a table, a column or a code path.

/// How a sale's discountValue is interpreted. PERCENT is a 0–100 percentage of
/// the original price; FIXED is an absolute amount in the price's own currency
/// (UZS), floored at zero so a discount can never produce a negative price.
enum SaleDiscountType {
  PERCENT
  FIXED
}

/// What a sale applies to. ALL_PRODUCTS is the only self-contained value — the
/// other three are resolved through SaleTarget rows, one per selected product,
/// category or dealer.
///
/// Adding a scope later (a brand, a vehicle make, a price band) needs NO schema
/// change beyond a new value here: SaleTarget.targetId is a plain id column with
/// no FK precisely so a new kind of target needs no new table and no migration
/// of existing rows. The service resolves scope through one table-driven map.
enum SaleScopeType {
  ALL_PRODUCTS
  PRODUCTS
  CATEGORIES
  DEALERS
}

/// An automatic discount campaign. Applied by the backend, never computed by a
/// mobile client. A sale is "active" when isActive is true and now falls inside
/// [startAt, endAt] — endAt null meaning open-ended.
model Sale {
  id            String           @id @db.VarChar(64)
  title         String           @db.VarChar(160)
  description   String?          @db.VarChar(1000)
  discountType  SaleDiscountType @map("discount_type")
  // PERCENT: 0 < value <= 100. FIXED: value > 0, in whole/fractional UZS.
  // Decimal (not Float) so a percentage like 12.5 and a money amount are both
  // exact — the same 14,2 shape CatalogPart.priceUzs uses for money.
  discountValue Decimal          @map("discount_value") @db.Decimal(14, 2)
  // Targeting. ALL_PRODUCTS ignores `targets`; every other scope reads them.
  scopeType     SaleScopeType    @default(ALL_PRODUCTS) @map("scope_type")
  startAt       DateTime         @map("start_at") @db.Timestamptz(3)
  // Null = runs until switched off.
  endAt         DateTime?        @map("end_at") @db.Timestamptz(3)
  isActive      Boolean          @default(true) @map("is_active")
  // Which sale wins when several apply to one product. Higher runs first; ties
  // break on the deeper discount, then on id, so the choice is deterministic.
  priority      Int              @default(0)
  // Soft delete. DELETE /v1/admin/sales/:id stamps this instead of removing the
  // row, so a campaign that ran — and the prices it produced — stays on file and
  // auditable. A deleted sale is invisible to every list and never applies to a
  // price; null means "not deleted", which is the state of every existing row.
  //
  // Distinct from isActive: isActive is an operational switch an admin flips back
  // and forth, deletedAt is terminal.
  deletedAt     DateTime?        @map("deleted_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  targets       SaleTarget[]

  // Covers the active-sale lookup: deletedAt and isActive first (most
  // selective), then the window bounds both endpoints filter on.
  @@index([deletedAt, isActive, startAt, endAt])
  @@map("sales")
}

/// One selected target of a scoped sale — a product, a category or a dealer.
/// `targetType` mirrors the parent sale's scopeType, so a single row is
/// self-describing and a future scope kind slots in without a new table.
///
/// targetId is deliberately NOT a foreign key: the three target kinds live in
/// three different tables (catalog_parts, part_categories, catalog_sellers) and
/// no single FK can point at all of them. The service validates existence at
/// write time; a target whose subject is later deleted simply stops matching.
model SaleTarget {
  id         String        @id @db.VarChar(64)
  saleId     String        @map("sale_id") @db.VarChar(64)
  targetType SaleScopeType @map("target_type")
  targetId   String        @map("target_id") @db.VarChar(64)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  sale       Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  // The same subject cannot be attached to one sale twice.
  @@unique([saleId, targetType, targetId])
  @@index([saleId])
  // "which sales target this product/category/dealer" — the discount lookup.
  @@index([targetType, targetId])
  @@map("sale_targets")
}

// ── 3D Fitment Studio (admin) ─────────────────────────────────────────────────
// Powers /v1/admin/fitment-studio/*: the operator binds catalog parts to a
// vehicle model at one of 7 hotspots on the shared 3D car model. Distinct from
// the buyer-side PartCompatibility (trim/engine-level fit) above — this is a
// model-level, node-anchored admin mapping surface.

// Fitment strength shown per bound part in the studio. Separate enum from the
// buyer-facing CompatibilityStatus (FITS/…): the studio's semantics differ.
enum FitmentStatus {
  EXACT_MATCH
  MAYBE
  UNIVERSAL
}

// The 7 hotspot categories on the shared 3D car model. One VehicleNode per
// category (category is @unique), seeded with coordinates matching the admin's
// three.js scene (see fitment-node.config.ts → NODE_SEED).
enum NodeCategory {
  ENGINE
  FRONT_BRAKES
  REAR_BRAKES
  SUSPENSION
  TRANSMISSION
  ELECTRICAL
  EXHAUST
}

/// A hotspot on the shared 3D car model. There are 7 today (one per
/// NodeCategory), seeded once with world-space coordinates that match the
/// admin's three.js scene (fitment-node.config.ts → NODE_SEED).
model VehicleNode {
  id        String       @id @default(uuid())
  category  NodeCategory @unique
  name      String // "Передние тормоза"
  positionX Float // 0.86
  positionY Float // 0.34
  positionZ Float // 1.30

  bindings FitmentBinding[]

  @@map("vehicle_nodes")
}

/// Join table: which CatalogPart fits which VehicleModelRef, at which 3D node.
/// `nodeId` is required (the studio always sends a node), which keeps the
/// composite unique simple and lets unbind target one exact row. The composite
/// unique makes bind idempotent.
model FitmentBinding {
  id String @id @default(uuid())

  partId String      @db.VarChar(64)
  part   CatalogPart @relation(fields: [partId], references: [id], onDelete: Cascade)

  vehicleModelId String          @db.VarChar(64)
  vehicleModel   VehicleModelRef @relation(fields: [vehicleModelId], references: [id], onDelete: Cascade)

  nodeId String
  node   VehicleNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  status    FitmentStatus @default(EXACT_MATCH)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([partId, vehicleModelId, nodeId])
  @@index([vehicleModelId, nodeId]) // node counts + unmapped filter
  @@index([partId])
  @@map("fitment_bindings")
}

// Lifecycle of a part-sourcing request opened by the AI chat when a customer
// asks for a part that isn't in local stock. Operators in mator-admin pick these
// up (via the NEW_SOURCING_TICKET realtime event) and move them through the
// funnel: PENDING -> IN_PROGRESS -> OFFERED -> CLOSED.
enum SourcingTicketStatus {
  PENDING
  IN_PROGRESS
  OFFERED
  ACCEPTED
  CLOSED
  CANCELLED
  NO_OFFER
}

// A seller's quote for a sourcing ticket. Price is the ONLY hard requirement —
// a seller who can't send a photo still files a valid, first-class offer, so
// `images` may be empty. Condition/availability/note are best-effort extras.
// `seller*` fields identify the Telegram dealer who quoted (no FK — dealers are
// Telegram users, not AppUsers). Delivered to the requesting customer as a
// SOURCING_OFFER notification.
enum SourcingOfferCondition {
  NEW
  USED
  OEM
  AFTERMARKET
  UNKNOWN
}

enum SourcingOfferAvailability {
  IN_STOCK
  ON_ORDER
  UNKNOWN
}

enum SourcingOfferStatus {
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

// Why a customer turned an offer down — feeds back to sourcing so operators /
// dealers can re-quote (e.g. TOO_EXPENSIVE → find a cheaper source).
enum SourcingOfferDeclineReason {
  TOO_EXPENSIVE
  FOUND_CHEAPER
  NO_LONGER_NEEDED
  OTHER
}

// One customer request: the idempotency record, plus the parent of its part
// items (one SourcingTicket per part). Unique per account + key, so a retry can
// only ever resolve to this request's own result.
enum SourcingRequestStatus {
  PROCESSING
  COMPLETED
}

model SourcingRequest {
  id             String                @id @default(uuid()) @db.Uuid
  userId         String                @map("user_id") @db.Uuid
  idempotencyKey String                @map("idempotency_key") @db.VarChar(128)
  // SHA-256 of what was asked. Reusing a key for anything else is a conflict.
  payloadHash    String                @map("payload_hash") @db.Char(64)
  status         SourcingRequestStatus @default(PROCESSING)
  // Whoever holds a live lease is the only one who may complete the request.
  leaseToken     String?               @map("lease_token") @db.VarChar(64)
  leaseExpiresAt DateTime?             @map("lease_expires_at") @db.Timestamptz(3)
  vehicleId      String?               @map("vehicle_id") @db.VarChar(64)
  response       Json?                 @db.JsonB
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           AppUser               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tickets        SourcingTicket[]

  @@unique([userId, idempotencyKey])
  @@map("sourcing_requests")
}

// One checkout per (buyer, Idempotency-Key). Written in the transaction that creates the
// order, so a row exists exactly when its order does: a retry finds it and gets that order
// back, and a failed checkout leaves nothing behind. Kept for as long as the order exists,
// so an old key can never place a second order; past `expiresAt` the key is only refused.
model OrderIdempotency {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.VarChar(128)
  // SHA-256 of the canonical checkout request. Reusing a key for anything else is a conflict.
  payloadHash    String   @map("payload_hash") @db.Char(64)
  orderId        String   @unique @map("order_id") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  // End of the replay window. After it the key is refused, never reused.
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  user           AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@map("order_idempotency")
}

// Whether a ticket's staff notification has gone out. NULL on tickets from
// before the outbox: they were already sent, and must never be resent.
enum SourcingStaffNotifyStatus {
  PENDING
  SENT
  FAILED
}

model SourcingOffer {
  id                    String                      @id @db.VarChar(64)
  ticketId              String                      @map("ticket_id") @db.Uuid
  price                 Int
  currency              String                      @default("UZS") @db.VarChar(8)
  condition             SourcingOfferCondition      @default(UNKNOWN)
  availability          SourcingOfferAvailability   @default(UNKNOWN)
  etaDays               Int?                        @map("eta_days")
  note                  String?                     @db.Text
  images                String[]                    @default([])
  sellerTgId            String                      @map("seller_tg_id")
  sellerName            String?                     @map("seller_name")
  sellerUsername        String?                     @map("seller_username")
  status                SourcingOfferStatus         @default(SENT)
  declineReason         SourcingOfferDeclineReason? @map("decline_reason")
  declineNote           String?                     @map("decline_note") @db.Text
  // What the part IS, for its receipt line: the category that supplies its MXIK and
  // the sale form that picks its package code. A seller's offer carries neither and
  // a part name is no classification, so an operator sets them in the sourcing
  // console; until then the offer cannot be paid for online. See
  // PaymeFiscalService.
  categoryId            String?                     @map("category_id") @db.VarChar(64)
  packageForm           PackageForm?                @map("package_form")
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  // NULL on offers from before expiry existed: those are left alone.
  expiresAt             DateTime?                   @map("expires_at") @db.Timestamptz(3)
  // In-app delivery still owed to the customer, retried until it lands.
  customerNotifyPending Boolean                     @default(false) @map("customer_notify_pending")
  ticket                SourcingTicket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  category              PartCategory?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  cartItems             CartItem[]

  @@index([ticketId])
  @@index([status])
  @@index([customerNotifyPending])
  @@index([status, expiresAt])
  @@index([categoryId])
  @@map("sourcing_offers")
}

// A sourcing request raised by AiChatService when RAG finds no in-stock match.
// `userId` is nullable and NOT a foreign key: the chat is available to
// anonymous customers and the id is client-supplied, so it's stored as an
// opaque tag rather than a constrained relation. `extractedData` is the LLM's
// structured extraction (brand/model/year/vin/part_name/preference) as jsonb.
model SourcingTicket {
  id                  String                     @id @default(uuid()) @db.Uuid
  userId              String?                    @map("user_id")
  rawMessage          String                     @map("raw_message") @db.Text
  extractedData       Json                       @map("extracted_data") @db.JsonB
  status              SourcingTicketStatus       @default(PENDING)
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  // The fields below are NULL on tickets from before SourcingRequest existed,
  // and every background job filters on them, so old tickets are never touched.
  requestId           String?                    @map("request_id") @db.Uuid
  partName            String?                    @map("part_name") @db.Text
  // Normalized part + vehicle, for spotting a customer asking for the same thing.
  partKey             String?                    @map("part_key") @db.Text
  vehicleKey          String?                    @map("vehicle_key") @db.VarChar(200)
  vehicleId           String?                    @map("vehicle_id") @db.VarChar(64)
  staffNotifyStatus   SourcingStaffNotifyStatus? @map("staff_notify_status")
  staffNotifyAttempts Int                        @default(0) @map("staff_notify_attempts")
  staffNotifyNextAt   DateTime?                  @map("staff_notify_next_at") @db.Timestamptz(3)
  staffNotifiedAt     DateTime?                  @map("staff_notified_at") @db.Timestamptz(3)
  staffNotifyError    String?                    @map("staff_notify_error") @db.Text
  escalatedAt         DateTime?                  @map("escalated_at") @db.Timestamptz(3)
  // A status update owed to the customer, retried until it lands.
  customerNotice      String?                    @map("customer_notice") @db.VarChar(32)
  request             SourcingRequest?           @relation(fields: [requestId], references: [id], onDelete: SetNull)
  offers              SourcingOffer[]

  @@index([status])
  @@index([userId])
  @@index([requestId])
  @@index([userId, partKey, vehicleKey])
  @@index([staffNotifyStatus, staffNotifyNextAt])
  @@index([customerNotice])
  @@map("sourcing_tickets")
}

// ── Legal documents & consent ────────────────────────────────────────────────
//
// Two models with strictly separate jobs (do not conflate them):
//   • LegalDocument   — the TEXT of one version of one document, per locale.
//   • LegalAcceptance — the PROOF that one user accepted one version, once.
//
// Versions are immutable and never deleted: an acceptance is evidence, and
// evidence that points at rewritten text proves nothing. Publishing a new
// version therefore INSERTS a row and flips `isActive`; it never UPDATEs the
// text of a version anyone may already have accepted.

/// One version of one legal document, in one locale. `version` is shared across
/// locales — TERMS_OF_USE v2 is the same instrument in `ru` and `uz`, so a user
/// who accepted it in either language has accepted v2.
///
/// "Currently required" = the active row for (type, locale). Prisma cannot
/// express the partial unique index that would enforce one-active-per-pair
/// (`WHERE is_active`), so the migration adds it by hand and LegalService
/// publishes through it; see the migration for the full rationale.
model LegalDocument {
  id            String            @id @default(uuid()) @db.Uuid
  type          LegalDocumentType
  version       Int
  /// Interface language code as it appears on the wire: 'ru' | 'uz' | 'en'
  /// (see common/app-lang.util). Stored as the lowercase code rather than the
  /// `Language` enum so a new locale is a data row, not a schema migration.
  locale        String            @db.VarChar(8)
  title         String            @db.VarChar(300)
  content       String            @db.Text
  contentFormat String            @default("markdown") @map("content_format") @db.VarChar(20)
  isActive      Boolean           @default(false) @map("is_active")
  effectiveAt   DateTime          @map("effective_at") @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  acceptances LegalAcceptance[]

  @@unique([type, version, locale])
  @@index([type, locale, isActive])
  @@map("legal_documents")
}

/// Evidence that a user accepted a specific version of a specific document at a
/// specific time. Append-only by design.
///
/// There is deliberately NO @@unique([userId, documentId]): a user accepts v1,
/// then later v2, and both rows must survive — the consent history IS the audit
/// trail. Re-accepting the SAME version is deduplicated in the service layer
/// (retry-safe) rather than by a constraint, so a genuine re-consent event
/// could still be recorded if the business ever needs it.
///
/// `documentVersion` duplicates `document.version` on purpose: the acceptance
/// must remain readable as "accepted v1" from the row alone, without a join.
model LegalAcceptance {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  documentId      String   @map("document_id") @db.Uuid
  documentVersion Int      @map("document_version")
  acceptedAt      DateTime @default(now()) @map("accepted_at") @db.Timestamptz(3)
  /// Request provenance, captured server-side (never trusted from the client) —
  /// it is what makes the row evidence rather than a claim. Nullable because a
  /// proxy may withhold the address and a client may send no User-Agent.
  ipAddress       String?  @map("ip_address") @db.VarChar(45)
  userAgent       String?  @map("user_agent") @db.VarChar(500)
  /// The language the user was actually shown the document in.
  locale          String?  @db.VarChar(8)

  user     AppUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: a document version that someone has accepted must not
  // be deletable — that would destroy the evidence the row exists to hold.
  document LegalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([documentId])
  @@index([userId, documentVersion])
  @@map("legal_acceptances")
}
