// ── Parts catalog (buyer-facing) ──────────────────────────────────────────────
model PartCategory {
  id                String            @id @db.VarChar(64)
  // INTERNAL canonical label. NOT a display field any more: every audience
  // (buyer app, seller bot, admin console) reads one of the three localized
  // names below. `name` survives because it is what slugs/ids are derived from,
  // what list ordering is stable on, and what a handful of internal tools log —
  // renaming it out would touch far more than localization does.
  name              String            @db.VarChar(160)
  // ── Localized display names (REQUIRED, one per supported language) ────────
  // The display name in each of the three languages Mator ships: Russian,
  // Uzbek (Latin script) and English. All three are NOT NULL — a category
  // without a name in one language would render blank for every user of that
  // language, so the admin write path rejects a missing/blank value rather than
  // silently falling back. `name_ru` / `name_uz` are the former `title_ru` /
  // `title_uz` columns (renamed in place, so no translation was lost);
  // `name_en` was backfilled from `name`, which was already English for the
  // seeded buyer buckets.
  nameRu            String            @map("name_ru") @db.VarChar(160)
  nameUz            String            @map("name_uz") @db.VarChar(160)
  nameEn            String            @map("name_en") @db.VarChar(160)
  // URL/display slug for the admin category-tree console. Backfilled from `id`
  // by the migration (ids are already slug-shaped), unique so a slug names one
  // category. Nullable to keep the backfill safe on legacy rows.
  slug              String?           @unique @db.VarChar(96)
  parentId          String?           @map("parent_id") @db.VarChar(64)
  iconUrl           String?           @map("icon_url")
  // Ordering among siblings in the admin tree (and any ordered listing). New
  // rows default to 0; the admin move endpoint sets an explicit value.
  sortOrder         Int               @default(0) @map("sort_order")
  // Accent color + icon key the buyer grid renders (mirrors the old hardcoded
  // MAIN_CATEGORIES metadata now that PartCategory is the source of truth).
  color             String?           @map("color") @db.VarChar(16)
  iconKey           String?           @map("icon_key") @db.VarChar(48)
  // Soft-delete / hide flag. The buyer grid only lists isActive rows; orphan
  // legacy rows are deactivated (never deleted — FK Restrict) by the migration.
  isActive          Boolean           @default(true) @map("is_active")
  // Which PartMainCategory enum this category mirrors (null = custom/vehicle
  // category). The 12 canonical buyer rows carry it; it links bot classification
  // (CatalogPart.mainCategory) → category on backfill + ingest.
  mainCategory      PartMainCategory? @map("main_category")
  // Depth in the tree, DERIVED from the parent chain (root = 0, its child = 1, …)
  // and never accepted from a client: the service computes it as parent.level + 1
  // on create/move. Stored (rather than walked per read) so the seller bot can
  // query one level directly, and so a level filter is an index hit.
  //   0 → Vehicle Category   1 → Main Category   2 → Subcategory
  // Deeper levels are structurally allowed; only these three are exposed today.
  level             Int               @default(0)
  // ── Fiscal data (Tasnif / soliq), owned by the CATEGORY ────────────────────
  // Every product of a category is fiscalized with the SAME code pair, so these
  // live here once instead of on every Product: an admin correcting a code fixes
  // every existing and future listing of that category with no product write.
  //
  // `mxik` (a.k.a. IKPU) is the 17-digit classifier code sent to Payme as
  // `code`. `packageCodeSingle` / `packageCodeSet` / `packageCodeBox` are TASNIF
  // PACKAGE codes — the form the item is SOLD in, "Штука", "Комплект / набор" or
  // "Потребительская коробка" — sent as `package_code`. Tasnif issues them PER MXIK:
  // "штука" is 1417722 on brakes and 1417728 on the steering mechanism, so a code
  // from one category means nothing on another. They are NOT ordered: each form has
  // its own named column precisely so nothing depends on which code an operator
  // happened to type first.
  //
  // All three are NULLABLE: existing rows predate fiscal configuration and a
  // category stays unconfigured until an admin enters real values (codes are
  // never guessed). The business rule — a configured category has BOTH `mxik`
  // and `packageCodeSingle` — is enforced by the admin write path, not by a DB
  // constraint, so no existing row can become unwritable. `packageCodeSet` and
  // `packageCodeBox` are optional: a second code is what makes the seller bot ask
  // the sale-form question at all (see WizardStep.PACKAGE_FORM), and what makes a
  // listing that states no form unpayable until someone says how it is sold.
  mxik              String?           @db.VarChar(17)
  packageCodeSingle String?           @map("package_code_single") @db.VarChar(20)
  packageCodeSet    String?           @map("package_code_set") @db.VarChar(20)
  packageCodeBox    String?           @map("package_code_box") @db.VarChar(20)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  parent            PartCategory?     @relation("PartCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children          PartCategory[]    @relation("PartCategoryTree")
  parts             CatalogPart[]
  sourcingOffers    SourcingOffer[]
  serviceOfferings  ProviderServiceOffering[]
  // Supply-side (seller bot) listings classified into this tree. Two relations
  // each: the root vehicle category and the precise selected node.
  products          Product[]         @relation("ProductCategory")
  productsVehicle   Product[]         @relation("ProductVehicleCategory")
  drafts            ProductDraft[]    @relation("ProductDraftCategory")
  draftsVehicle     ProductDraft[]    @relation("ProductDraftVehicleCategory")

  @@index([parentId])
  @@index([parentId, sortOrder])
  @@index([mainCategory])
  @@index([level])
  @@index([isActive])
  @@map("part_categories")
}

model PartBrand {
  id      String        @id @db.VarChar(64)
  name    String        @db.VarChar(120)
  logoUrl String?       @map("logo_url")
  parts   CatalogPart[]

  @@map("part_brands")
}

// Buyer-facing seller projection of the internal Seller (seller_<slug>).
model CatalogSeller {
  id               String        @id @db.VarChar(64)
  name             String        @db.VarChar(160)
  ratingAvg        Decimal       @default(0) @map("rating_avg") @db.Decimal(3, 2)
  logoUrl          String?       @map("logo_url")
  internalSellerId Int?          @map("internal_seller_id") // link to supply-side Seller, not exposed
  // "MATOR Certified" storefront presentation (nullable — only curated dealer
  // rows carry these; projected seller_<id> rows leave them null).
  // `isCurated` is the AUTHORITATIVE marker of a curated dealer — GET /v1/dealers
  // filters on it, NOT on whether these presentation fields happen to be set. A
  // projected seller_<id> row that later acquires an `initial` must never leak
  // into the dealer list, so identity is an explicit flag, not field presence.
  isCurated        Boolean       @default(false) @map("is_curated")
  initial          String?       @db.VarChar(4) // monogram letter for the logo tile
  color            String?       @db.VarChar(9) // brand accent hex (#RRGGBB[AA])
  orders           String?       @db.VarChar(20) // pre-formatted lifetime order count, e.g. "18k+"
  years            Int? // years in business
  // ── Admin dealer console (/v1/admin/dealers) ──
  // A dealer IS a CatalogSeller; these columns carry the moderation state and
  // the commercial metrics the console shows. All are additive with safe
  // defaults, so every existing row (curated or projected) keeps working and
  // GET /v1/dealers is byte-for-byte unaffected.
  city             String?       @db.VarChar(120)
  // Dealer contact, used by the console's search and detail view. Held here
  // rather than read through internalSellerId: that column is a loose id with
  // no FK (the projection writes it opportunistically), the supply-side Seller
  // has no email column at all, and its `phone` is the Telegram account behind
  // the listing rather than the storefront's public contact. Nothing is
  // duplicated — this is the only place a dealer's own contact details live.
  email            String?       @db.VarChar(255)
  phoneE164        String?       @map("phone_e164") @db.VarChar(20)
  // Brand accent for the admin console. Distinct from `color`: `color` is the
  // legacy storefront field GET /v1/dealers still returns, and is only set on
  // curated rows. Kept separate rather than reused so neither surface can
  // silently repaint the other; the seed points both at the same value.
  brandColor       String?       @map("brand_color") @db.VarChar(9)
  certified        Boolean       @default(false)
  lowestPrice      Boolean       @default(false) @map("lowest_price")
  status           DealerStatus  @default(PENDING)
  // Why the dealer was suspended, as typed by the acting admin. Cleared on
  // reactivation so a stale reason can never trail an active dealer.
  suspendedReason  String?       @map("suspended_reason") @db.VarChar(500)
  // Lifetime gross merchandise value in whole UZS. Stored, not derived:
  // OrderItem deliberately holds no FK to the catalog (immutable snapshot), so
  // there is no join that could compute a seller's GMV. BigInt because lifetime
  // UZS overruns a 32-bit integer at ~2.1bn (a few hundred orders).
  gmvUzs           BigInt        @default(0) @map("gmv_uzs")
  // Lifetime order count as an INTEGER. `orders` above is a different thing —
  // a pre-formatted display string ("18k+") that GET /v1/dealers returns — and
  // is left untouched so that contract does not change.
  ordersCount      Int           @default(0) @map("orders_count")
  // ── Налоговые данные (fiscal identity of the dealer) ──────────────────────
  // Set by an operator in the admin console ONLY — there is no automatic
  // tax-status lookup and the seller bot never asks for these. Both feed the
  // Payme receipt of every item this dealer sells: `tin` → commission_info.tin,
  // `vatPercent` → vat_percent.
  //
  // `tin` is a STRING, never a number: it is an identifier whose leading zeros
  // are significant, and it holds either a 9-digit ИНН or a 14-digit ПИНФЛ.
  //
  // Both are NULLABLE and have NO default. Null means "not configured yet",
  // which is a genuinely different fact from a configured 0% rate — defaulting
  // vatPercent to 0 would silently fiscalize every unconfigured dealer as
  // VAT-exempt. Products of such a dealer are still created and listed
  // normally; only Payme checkout refuses them (see PaymeFiscalService), and
  // filling these two columns in makes every existing product of the dealer
  // payable at once, with no product write.
  tin              String?       @db.VarChar(14)
  vatPercent       Decimal?      @map("vat_percent") @db.Decimal(5, 2)
  // ── 1C integration credential (POST /v1/integrations/dealers/sync-inventory) ──
  // SHA-256 hash of the dealer's X-API-KEY, hex-encoded — never the key itself.
  // The endpoint is machine-to-machine, so the credential is a bearer secret in
  // a header: anyone holding it can rewrite this dealer's stock and prices.
  // Storing only the digest means a database leak does not hand out working
  // keys, exactly like AppAdmin.passwordHash. Unique so one key resolves to at
  // most one dealer, and so the guard can look the caller up by hash in a single
  // indexed read instead of scanning every dealer row.
  //
  // NULL means "no integration configured" — the overwhelming majority of rows,
  // including every projected seller_<id> one. A null must never match: the
  // guard rejects an absent/blank header before it ever queries.
  apiKeyHash       String?       @unique @map("api_key_hash") @db.VarChar(64)
  // Last 4 characters of the plaintext key, for operator display ("…8f2c") and
  // support ("which key is 1C using?"). 4 characters of a 43-character random
  // key are not enough to shorten a brute-force search meaningfully, and this
  // is what lets an operator identify a key without the system ever being able
  // to reveal it.
  apiKeyLast4      String?       @map("api_key_last4") @db.VarChar(4)
  // When the key was issued, and when it was last accepted by the guard. The
  // second is the operational signal that answers "is this dealer's 1C actually
  // syncing?" without reading logs. Written on every successful sync.
  apiKeyIssuedAt   DateTime?     @map("api_key_issued_at") @db.Timestamptz(3)
  apiKeyLastUsedAt DateTime?     @map("api_key_last_used_at") @db.Timestamptz(3)
  // When the dealer joined. Existing rows have no creation timestamp, so the
  // migration backfills them to now(); new rows default to insert time.
  joinedAt         DateTime      @default(now()) @map("joined_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  parts            CatalogPart[]

  @@index([internalSellerId])
  // Covering the console's default sort and its status filter.
  @@index([status, joinedAt])
  @@map("catalog_sellers")
}

// Moderation state of a dealer. The admin console drives the transitions:
// PENDING → ACTIVE (approve), ACTIVE → SUSPENDED (suspend), SUSPENDED → ACTIVE
// (reactivate). Lowercased on the wire ("active"), like OrderStatus.
enum DealerStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model CatalogPart {
  id                 String               @id @db.VarChar(64)
  title              String               @db.VarChar(255)
  brandId            String?              @map("brand_id") @db.VarChar(64)
  categoryId         String               @map("category_id") @db.VarChar(64)
  sellerId           String               @map("seller_id") @db.VarChar(64)
  // OEM numbers this part is sold under. Populated ONLY from a seller-labeled OEM
  // number or an UNKNOWN (unlabeled) number — never from a GM-labeled number.
  oemNumbers         String[]             @map("oem_numbers")
  // GM numbers this part is sold under. Populated ONLY from a seller-labeled GM
  // number or an UNKNOWN (unlabeled) number. An UNKNOWN number appears in BOTH
  // arrays so it is findable by either search; a labeled number appears in one.
  gmNumbers          String[]             @map("gm_numbers")
  // How the seller labeled the number (mirrors Product.partNumberType).
  partNumberType     PartNumberType       @default(UNKNOWN) @map("part_number_type")
  // Retail (sell) price shown to buyers. Historically the only price on a part.
  priceUzs           Decimal              @map("price_uzs") @db.Decimal(14, 2)
  // Wholesale/purchase cost the dealer paid, driving the Smart-Inventory margin
  // view. Nullable: legacy rows have no known cost.
  purchasePriceUzs   Decimal?             @map("purchase_price_uzs") @db.Decimal(14, 2)
  // Cashback returned to the buyer as a percentage of the retail price (0–100).
  cashbackPct        Decimal              @default(0) @map("cashback_pct") @db.Decimal(5, 2)
  currency           String               @default("UZS") @db.VarChar(3)
  condition          PartCondition        @default(NEW)
  // Boolean availability flag GET /v1/... surfaces (kept for back-compat).
  inStock            Boolean              @default(true) @map("in_stock")
  // On-hand unit count. The Smart-Inventory console reads/writes this; the
  // stock-status derivation (out/low/in) compares it to lowStockThreshold.
  stockQty           Int                  @default(0) @map("stock_qty")
  // Units of stockQty Mator has promised: the unreleased, unreconciled part of this
  // part's inventory_reservations. Written only with those rows, in one transaction.
  // stockQty stays what the supplier reported; a buyer can have stockQty - reservedQty.
  reservedQty        Int                  @default(0) @map("reserved_qty")
  reservations       InventoryReservation[]
  // Per-row low-stock threshold. 0 < qty < threshold ⇒ "low_stock".
  lowStockThreshold  Int                  @default(5) @map("low_stock_threshold")
  deliveryEtaDaysMin Int?                 @map("delivery_eta_days_min")
  deliveryEtaDaysMax Int?                 @map("delivery_eta_days_max")
  images             String[]
  // Classified taxonomy + attributes, projected from the supply-side Product.
  // Indexed for efficient buyer-side filtering/faceting.
  mainCategory       PartMainCategory?    @map("main_category")
  vehicleCategory    PartVehicleCategory? @map("vehicle_category")
  partBrandName      String?              @map("part_brand_name") @db.VarChar(120)
  originRegion       PartOriginRegion?    @map("origin_region")
  isOem              Boolean              @default(false) @map("is_oem")
  isGm               Boolean              @default(false) @map("is_gm")
  isUniversal        Boolean              @default(false) @map("is_universal")
  // Listing kind + the kind-specific attributes, projected verbatim from the
  // supply-side Product so the buyer side can render an oil card (viscosity /
  // type / volume) without joining back to the seller domain.
  kind               ProductKind          @default(SPARE_PART)
  oilViscosity       String?              @map("oil_viscosity") @db.VarChar(20)
  oilType            OilType?             @map("oil_type")
  oilVolumeMl        Int?                 @map("oil_volume_ml")
  // ANTIFREEZE net weight in GRAMS, projected verbatim from the supply-side
  // Product so the buyer card can render "2.5 кг" without joining back.
  antifreezeWeightG  Int?                 @map("antifreeze_weight_g")
  // The listing's sale form, projected verbatim from the supply-side Product so
  // the Payme fiscal builder resolves `package_code` from this row's own
  // category WITHOUT joining back to the seller domain (the two contexts share
  // no FKs). Same semantics as the source column: null = never asked. An operator
  // can state it here (bulk-move), so it travels with the classification rather than
  // with every re-projection.
  packageForm        PackageForm?         @map("package_form")
  // Curated product rating, projected verbatim from the supply-side Product so
  // the buyer catalog renders stars WITHOUT joining back to the seller domain
  // (the two contexts share no FKs). Same types and semantics as the source
  // columns: NULL ratingAvg = unrated, reviewCount 0 = no ratings yet.
  ratingAvg          Decimal?             @map("rating_avg") @db.Decimal(2, 1)
  reviewCount        Int                  @default(0) @map("review_count")
  // Bestseller signals for the macro-category ("Shop by system") rollup. Both are
  // denormalized: `salesCount` is a periodically-updated order count, `isBestseller`
  // an editorial/derived flag. Default 0/false so the bestseller sort degrades to
  // rating/review tiebreakers until a population job (or admin toggle) fills them.
  isBestseller       Boolean              @default(false) @map("is_bestseller")
  salesCount         Int                  @default(0) @map("sales_count")
  // Manual rank in the Fitment Studio's digitization queue (`filter=top300`):
  // 1 = digitize first. NULL = not queued, which is most of the catalogue — the
  // queue is a curated few hundred, not the whole table. Explicit (not derived
  // from salesCount) so an operator can promote a part that has never sold yet;
  // prisma/backfill-fitment-priority.ts seeds the first pass from sales.
  fitmentPriority    Int?                 @map("fitment_priority")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  brand              PartBrand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category           PartCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  seller             CatalogSeller        @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  compatibilities    PartCompatibility[]
  fits               CatalogPartFit[]
  makeFits           CatalogPartMakeFit[]
  fitmentBindings    FitmentBinding[]

  @@index([categoryId])
  @@index([brandId])
  @@index([sellerId])
  @@index([inStock])
  @@index([mainCategory])
  @@index([vehicleCategory])
  @@index([originRegion])
  @@index([isGm])
  @@index([isOem])
  @@index([kind])
  @@index([stockQty])
  // Hot path: filter by macro-category, order bestsellers first.
  @@index([mainCategory, isBestseller, salesCount])
  // Fitment Studio queue: the prioritized slice, in its stable display order.
  @@index([fitmentPriority])
  @@map("catalog_parts")
}

// Denormalized make/model fitment for the buyer catalog, projected from the
// supply-side PartModel links. Enables indexed server-side filtering by vehicle
// make and model (independent of the trim/engine-level PartCompatibility used
// for garage-vehicle fit). Names are canonical (see vehicle-catalog.ts); slugs
// mirror the frontend contract's make/model ids (e.g. make_chevrolet).
model CatalogPartFit {
  partId    String      @map("part_id") @db.VarChar(64)
  makeSlug  String      @map("make_slug") @db.VarChar(80)
  modelSlug String      @map("model_slug") @db.VarChar(96)
  makeName  String      @map("make_name") @db.VarChar(120)
  modelName String      @map("model_name") @db.VarChar(120)
  part      CatalogPart @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@id([partId, modelSlug])
  @@index([makeSlug])
  @@index([modelSlug])
  @@map("catalog_part_fits")
}

// Make-wide fitment for the buyer catalog ("fits every model of this make"),
// projected from the supply-side part_makes links. Kept separate from
// catalog_part_fits, whose rows always name ONE model: a sentinel model there
// would surface in every client that lists fitted models. Slug/name follow the
// same convention as catalog_part_fits (make_<slug>, canonical make name).
model CatalogPartMakeFit {
  partId   String      @map("part_id") @db.VarChar(64)
  makeSlug String      @map("make_slug") @db.VarChar(80)
  makeName String      @map("make_name") @db.VarChar(120)
  part     CatalogPart @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@id([partId, makeSlug])
  @@index([makeSlug])
  @@map("catalog_part_make_fits")
}

model PartCompatibility {
  id         String              @id @db.VarChar(64)
  partId     String              @map("part_id") @db.VarChar(64)
  trimId     String?             @map("trim_id") @db.VarChar(64)
  engineId   String?             @map("engine_id") @db.VarChar(64)
  years      Int[]
  status     CompatibilityStatus @default(FITS)
  confidence Decimal             @default(1) @db.Decimal(4, 3)
  source     String?             @db.VarChar(80)
  part       CatalogPart         @relation(fields: [partId], references: [id], onDelete: Cascade)
  trim       VehicleTrim?        @relation(fields: [trimId], references: [id], onDelete: SetNull)
  engine     VehicleEngine?      @relation(fields: [engineId], references: [id], onDelete: SetNull)

  @@index([partId])
  @@index([trimId])
  @@index([engineId])
  @@map("part_compatibilities")
}

// ── Cart (server-persisted, one per user) ─────────────────────────────────────
model Cart {
  id               String     @id @db.VarChar(64)
  userId           String     @unique @map("user_id") @db.Uuid
  promoCode        String?    @map("promo_code") @db.VarChar(60)
  promoDiscountUzs Decimal?   @map("promo_discount_uzs") @db.Decimal(14, 2)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             AppUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  items            CartItem[]

  @@map("carts")
}

model CartItem {
  id               String         @id @db.VarChar(64)
  cartId           String         @map("cart_id") @db.VarChar(64)
  partId           String?        @map("part_id") @db.VarChar(64)
  serviceId        String?        @map("service_id") @db.VarChar(64)
  providerId       String?        @map("provider_id") @db.VarChar(64)
  vehicleId        String?        @map("vehicle_id") @db.VarChar(64)
  offerId          String?        @map("offer_id") @db.VarChar(64)
  title            String         @db.VarChar(255)
  imageUrl         String?        @map("image_url")
  quantity         Int            @default(1)
  scheduledAt      DateTime?      @map("scheduled_at") @db.Timestamptz(3)
  priceUzsSnapshot Decimal        @map("price_uzs_snapshot") @db.Decimal(14, 2)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  offer            SourcingOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@map("cart_items")
}

// ── Orders & payments ─────────────────────────────────────────────────────────
model Order {
  id                String               @id @db.VarChar(64)
  userId            String               @map("user_id") @db.Uuid
  status            OrderStatus          @default(PENDING_PAYMENT)
  subtotalUzs       Decimal              @map("subtotal_uzs") @db.Decimal(14, 2)
  deliveryUzs       Decimal              @default(0) @map("delivery_uzs") @db.Decimal(14, 2)
  // How deliveryUzs was arrived at, written once with it: one entry per seller the courier
  // collects from, as { sellerId, pickup, tariffVersion, distanceMeters, billableKm,
  // priceUzs }, where pickup is an exact { lat, lng } point. Never served to the buyer,
  // cleared on account deletion, and null when no courier price was computed. Holds no
  // duration or geometry.
  deliveryShipments Json?                @map("delivery_shipments")
  // Where the courier goes, written once with it: { addressId, lat, lng, label, fullText,
  // regionCode, district, street, landmark } as they stood when the order was placed. The
  // address row can change or be deleted later, and this does not. Never served to the
  // buyer, cleared on account deletion.
  deliveryDestination Json?              @map("delivery_destination")
  // Mator's service fee, written once with the rest of the charges (see service-fee.util).
  // Part of totalUzs, and of nothing else: not of a line price, of deliveryUzs, or of what a
  // seller is owed.
  serviceFeeUzs     Decimal              @default(0) @map("service_fee_uzs") @db.Decimal(14, 2)
  discountUzs       Decimal              @default(0) @map("discount_uzs") @db.Decimal(14, 2)
  totalUzs          Decimal              @map("total_uzs") @db.Decimal(14, 2)
  currency          String               @default("UZS") @db.VarChar(3)
  vehicleId         String?              @map("vehicle_id") @db.VarChar(64)
  deliveryAddressId String?              @map("delivery_address_id") @db.VarChar(64)
  deliveryMethod    DeliveryMethod?      @map("delivery_method")
  paymentType       PaymentType?         @map("payment_type")
  contactPhoneE164  String?              @map("contact_phone_e164") @db.VarChar(20)
  promoCode         String?              @map("promo_code") @db.VarChar(60)
  yandexClaimId     String?              @map("yandex_claim_id") @db.VarChar(100)
  expiresAt         DateTime?            @map("expires_at") @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              AppUser              @relation(fields: [userId], references: [id], onDelete: Restrict)
  vehicle           Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  deliveryAddress   Address?             @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  inventoryReservations InventoryReservation[]
  payments          Payment[]
  statusHistory     OrderStatusHistory[]
  financialRefunds  FinancialRefund[]
  idempotency       OrderIdempotency?
  // Set while the registry accounts for all the money this order took in, so "is a
  // refund still owed" can be filtered without summing per row. Maintained only in
  // the transaction that writes the registry: see financial-refund.ledger.ts.
  refundSettledAt   DateTime?            @map("refund_settled_at") @db.Timestamptz(3)
  // Sellers are not paid for this order while it is set: a cancellation or a return is under
  // way. Set when Payme asks for a refund that is refused, or by an operator; released by an
  // operator. See AdminFinanceService.
  payoutHoldAt      DateTime?            @map("payout_hold_at") @db.Timestamptz(3)
  payoutHoldReason  String?              @map("payout_hold_reason") @db.VarChar(500)
  // True on a cash or terminal order placed since offline collection was tracked. Such an
  // order goes through processing and delivery without PAID, and its money counts as
  // received once offlineCollection exists. False on every older row, which keeps its
  // original reading (PAID means received): nothing is backfilled.
  offlineCollectionRequired Boolean    @default(false) @map("offline_collection_required")
  offlineCollection OfflineCollection?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

// Cash or terminal money actually collected for an order, written once by the operator who
// records it. The unique order_id is what makes a repeated request unable to count it twice.
model OfflineCollection {
  id                String      @id @db.VarChar(64)
  orderId           String      @unique @map("order_id") @db.VarChar(64)
  method            PaymentType
  amountUzs         Decimal     @map("amount_uzs") @db.Decimal(14, 2)
  // The terminal slip or cash document, when there is one.
  reference         String?     @db.VarChar(120)
  // The number of a receipt issued outside Mator, as the operator states it. Optional: a
  // collection neither needs one nor waits for one, and no fiscal provider is involved.
  fiscalReference   String?     @map("fiscal_reference") @db.VarChar(120)
  note              String?     @db.VarChar(500)
  collectedAt       DateTime    @map("collected_at") @db.Timestamptz(3)
  // Copied, so the record outlives the administrator's account.
  collectedByAdminId String     @map("collected_by_admin_id") @db.VarChar(64)
  collectedByName   String      @map("collected_by_name") @db.VarChar(255)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  order             Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([collectedAt])
  @@map("offline_collections")
}

// How the money went back to the customer. PROVIDER means through the payment
// provider's own cabinet or callback; the rest happen outside any provider.
enum RefundMethod {
  PROVIDER
  TERMINAL
  CASH
  BANK_TRANSFER
}

// Who put the entry in the registry.
enum RefundSource {
  MANUAL
  PROVIDER_CALLBACK
}

// The registry of money actually returned to customers. Separate from the order
// and payment statuses on purpose: an entry records that money moved and says what
// proves it, and it never changes a status. REFUNDED stays the provider's word
// alone. Entries are never deleted: a mistake is voided, with a reason, so the
// history of what was claimed survives.
model FinancialRefund {
  id                  String       @id @db.VarChar(64)
  orderId             String       @map("order_id") @db.VarChar(64)
  // Null when no payment row exists, as for cash and terminal orders.
  paymentId           String?      @map("payment_id") @db.VarChar(64)
  amountUzs           Decimal      @map("amount_uzs") @db.Decimal(14, 2)
  // How much of amountUzs is the service fee going back. The fee is Mator's income and
  // nobody else's, so what stays of it can only be told if each refund says this. See
  // readRefundPosition.
  serviceFeeUzs       Decimal      @default(0) @map("service_fee_uzs") @db.Decimal(14, 2)
  // How much of amountUzs is delivery going back. What is left of the amount after the
  // fee and delivery is goods, split between sellers in `allocations`.
  deliveryUzs         Decimal      @default(0) @map("delivery_uzs") @db.Decimal(14, 2)
  method              RefundMethod
  source              RefundSource @default(MANUAL)
  // The document behind it: a provider transaction id, a cabinet record, a receipt.
  reference           String       @db.VarChar(120)
  // The return receipt a cash register or the OFD issued for a refund made outside a
  // provider. Null for a provider refund: Payme registers its own CANCEL receipt.
  fiscalReference     String?      @map("fiscal_reference") @db.VarChar(120)
  reason              String       @db.VarChar(500)
  // When the money moved, which can be earlier than when it was written down.
  refundedAt          DateTime     @map("refunded_at") @db.Timestamptz(3)
  // Set when the provider's own callback confirms the refund.
  providerConfirmedAt DateTime?    @map("provider_confirmed_at") @db.Timestamptz(3)
  // Snapshots rather than FKs, like the audit trail: the entry must stay readable
  // after an administrator is removed. Null for a provider callback.
  createdById         String?      @map("created_by_id")
  createdByEmail      String?      @map("created_by_email") @db.VarChar(255)
  createdByName       String?      @map("created_by_name") @db.VarChar(120)
  voidedAt            DateTime?    @map("voided_at") @db.Timestamptz(3)
  voidedById          String?      @map("voided_by_id")
  voidedByEmail       String?      @map("voided_by_email") @db.VarChar(255)
  voidReason          String?      @map("void_reason") @db.VarChar(500)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  order               Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment             Payment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  allocations         FinancialRefundAllocation[]

  @@index([orderId])
  @@index([paymentId])
  @@index([refundedAt])
  @@map("financial_refunds")
}

// Whose goods a refund gave money back for, so what each seller is owed can be told. The
// rest of a refund is the service fee and delivery, stated on the entry itself. Written
// with the entry and never changed: voiding the entry voids these with it. Mator takes no
// commission from sellers, so an allocation is the goods amount and nothing else.
model FinancialRefundAllocation {
  id        String          @id @db.VarChar(64)
  refundId  String          @map("refund_id") @db.VarChar(64)
  // CatalogSeller.id, as frozen on the order line. A plain id, like order_items.seller_id.
  sellerId  String          @map("seller_id") @db.VarChar(64)
  amountUzs Decimal         @map("amount_uzs") @db.Decimal(14, 2)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  refund    FinancialRefund @relation(fields: [refundId], references: [id], onDelete: Restrict)

  @@unique([refundId, sellerId])
  @@index([sellerId])
  @@map("financial_refund_allocations")
}

// How Mator sent a seller their money.
enum PayoutMethod {
  BANK_TRANSFER
  CASH
}

// Money Mator sent a seller for their goods: the buyer pays Mator, and Mator settles with
// the sellers. One row per transfer, not per order. Like the refund registry, a mistake is
// voided with a reason and never deleted.
model SellerPayout {
  id             String       @id @db.VarChar(64)
  // CatalogSeller.id. A plain id: a storefront can be renamed or removed, a payment cannot.
  sellerId       String       @map("seller_id") @db.VarChar(64)
  amountUzs      Decimal      @map("amount_uzs") @db.Decimal(14, 2)
  method         PayoutMethod
  // The document behind it: a payment order number, a cash receipt.
  reference      String       @db.VarChar(120)
  note           String?      @db.VarChar(500)
  // When the money moved, which can be earlier than when it was written down.
  paidAt         DateTime     @map("paid_at") @db.Timestamptz(3)
  createdById    String?      @map("created_by_id")
  createdByEmail String?      @map("created_by_email") @db.VarChar(255)
  createdByName  String?      @map("created_by_name") @db.VarChar(120)
  voidedAt       DateTime?    @map("voided_at") @db.Timestamptz(3)
  voidedById     String?      @map("voided_by_id")
  voidedByEmail  String?      @map("voided_by_email") @db.VarChar(255)
  voidReason     String?      @map("void_reason") @db.VarChar(500)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([sellerId])
  @@index([paidAt])
  @@map("seller_payouts")
}

// Snapshot line item (no FK to catalog — immutable order history).
model OrderItem {
  id           String    @id @db.VarChar(64)
  orderId      String    @map("order_id") @db.VarChar(64)
  partId       String?   @map("part_id") @db.VarChar(64)
  serviceId    String?   @map("service_id") @db.VarChar(64)
  providerId   String?   @map("provider_id") @db.VarChar(64)
  // An accepted sourcing offer and the seller who made it (SourcingOffer.sellerTgId).
  // Physical goods with no catalog part: these two are what keep such a line from
  // reading as a service, and name whose tax data its receipt line needs. Plain
  // ids, like partId: the ticket and its offers can be deleted, the order cannot.
  offerId         String? @map("offer_id") @db.VarChar(64)
  offerSellerTgId String? @map("offer_seller_tg_id")
  // The storefront (CatalogSeller.id) that sold this line, as it stood when the order was
  // placed: a part can be delisted or change hands afterwards, and what is owed for this
  // sale cannot. A plain id, for the same reason as partId. Null on a service line, whose
  // provider is providerId, and when no seller could be found.
  sellerId     String?   @map("seller_id") @db.VarChar(64)
  title        String    @db.VarChar(255)
  quantity     Int       @default(1)
  priceUzs     Decimal   @map("price_uzs") @db.Decimal(14, 2)
  lineTotalUzs Decimal   @map("line_total_uzs") @db.Decimal(14, 2)
  scheduledAt  DateTime? @map("scheduled_at") @db.Timestamptz(3)
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventoryReservation InventoryReservation?

  @@index([orderId])
  @@map("order_items")
}

enum InventoryReservationStatus {
  // Promised to an order that may still fall through.
  HELD
  // Sold: paid online, or handed to fulfilment. Stays deducted until the source shows it.
  ALLOCATED
  // Given back. The units are sellable again.
  RELEASED
  // The supplier's own count now includes this sale. Nothing is deducted any more.
  RECONCILED
}

enum InventoryReconciliationSource {
  SOURCE_IMPORT
  OPERATOR
}

// One order line's claim on one counted position. The row outlives what it points at:
// each foreign key is SET NULL and the *Ref and snapshot columns keep it readable, so a
// sale stays on record when an order or part goes. A Telegram listing has no count and
// gets no row.
model InventoryReservation {
  id                   String                         @id @db.VarChar(64)
  orderId              String?                        @map("order_id") @db.VarChar(64)
  orderItemId          String?                        @unique @map("order_item_id") @db.VarChar(64)
  partId               String?                        @map("part_id") @db.VarChar(64)
  // Set only for a part projected from a Stock row. HTTP and admin counts have none.
  stockId              Int?                           @map("stock_id")
  // Copies of the ids above. orderItemRef is the idempotency key of a reservation.
  orderRef             String                         @map("order_ref") @db.VarChar(64)
  orderItemRef         String                         @unique @map("order_item_ref") @db.VarChar(64)
  partRef              String                         @map("part_ref") @db.VarChar(64)
  sellerId             String                         @map("seller_id") @db.VarChar(64)
  sellerName           String                         @map("seller_name") @db.VarChar(255)
  title                String                         @db.VarChar(255)
  partNumbers          String[]                       @map("part_numbers")
  quantity             Int
  // Units the source has shown, and units put back by hand after a return. What is still
  // deducted is quantity - reconciledQty - restockedQty.
  reconciledQty        Int                            @default(0) @map("reconciled_qty")
  restockedQty         Int                            @default(0) @map("restocked_qty")
  status               InventoryReservationStatus     @default(HELD)
  createdAt            DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  statusChangedAt      DateTime                       @default(now()) @map("status_changed_at") @db.Timestamptz(3)
  // NULL for a cash or terminal order, which has no payment window.
  expiresAt            DateTime?                      @map("expires_at") @db.Timestamptz(3)
  // A source file can only show a sale it was exported after.
  allocatedAt          DateTime?                      @map("allocated_at") @db.Timestamptz(3)
  // The goods have left the seller. Ordinary cancellation no longer gives them back.
  fulfilledAt          DateTime?                      @map("fulfilled_at") @db.Timestamptz(3)
  // The order ended with goods out or money taken: waits for an operator's restock.
  returnPendingAt      DateTime?                      @map("return_pending_at") @db.Timestamptz(3)
  releasedAt           DateTime?                      @map("released_at") @db.Timestamptz(3)
  releaseReason        String?                        @map("release_reason") @db.VarChar(500)
  reconciledAt         DateTime?                      @map("reconciled_at") @db.Timestamptz(3)
  reconciliationSource InventoryReconciliationSource? @map("reconciliation_source")
  // Which file, or which operator and why.
  reconciliationRef    String?                        @map("reconciliation_ref") @db.VarChar(500)
  // Why the last file could not settle this sale. Cleared when something settles it.
  reconciliationNote   String?                        @map("reconciliation_note") @db.VarChar(500)
  order                Order?                         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItem            OrderItem?                     @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  part                 CatalogPart?                   @relation(fields: [partId], references: [id], onDelete: SetNull)
  stock                Stock?                         @relation(fields: [stockId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([partId, status])
  @@index([stockId, status])
  @@index([sellerId, status])
  @@index([status, createdAt])
  @@map("inventory_reservations")
}

enum StockShortageCause {
  // The supplier does not have it, or Mator has already sold what it had.
  SOURCE_STOCK
  // The units exist, and other Mator orders are holding them for now.
  MATOR_RESERVATIONS
}

// A checkout refused for quantity. Written after the order rolled back, so it never
// describes an order that exists. dedupeKey is one cart line, quantity and cause: a retry
// counts here and cannot open a second sourcing ticket.
model StockShortageAttempt {
  id                String             @id @db.VarChar(64)
  dedupeKey         String             @unique @map("dedupe_key") @db.VarChar(200)
  cartItemRef       String             @map("cart_item_ref") @db.VarChar(64)
  partId            String             @map("part_id") @db.VarChar(64)
  title             String             @db.VarChar(255)
  partNumbers       String[]           @map("part_numbers")
  sellerId          String             @map("seller_id") @db.VarChar(64)
  sellerName        String             @map("seller_name") @db.VarChar(255)
  requestedQty      Int                @map("requested_qty")
  reportedQty       Int                @map("reported_qty")
  heldQty           Int                @map("held_qty")
  allocatedQty      Int                @map("allocated_qty")
  availableQty      Int                @map("available_qty")
  cause             StockShortageCause
  alternativesCount Int                @default(0) @map("alternatives_count")
  // The existing sourcing ticket this opened. A plain id, as tickets can be deleted.
  sourcingTicketId  String?            @map("sourcing_ticket_id") @db.Uuid
  attempts          Int                @default(1)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  lastAttemptAt     DateTime           @default(now()) @map("last_attempt_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([partId])
  @@map("stock_shortage_attempts")
}

// Append-only audit trail of order status transitions. Each row snapshots the
// actor (id + display name at write time, like the SMS accounting snapshot) so
// history stays immutable against later profile edits / user deletion. No FK to
// app_users for the actor — the snapshot is the record of truth. actorType/
// actorId/actorName are null for SYSTEM transitions.
model OrderStatusHistory {
  id        String         @id @db.VarChar(64)
  orderId   String         @map("order_id") @db.VarChar(64)
  status    OrderStatus
  note      String?        @db.VarChar(500)
  actorType OrderActorType @default(SYSTEM) @map("actor_type")
  // Holds the id of whoever caused the transition — an app USER (uuid) OR an
  // ADMIN operator (cuid, app_admins.id). Must therefore be a plain string, not
  // uuid, or operator status writes fail casting the cuid to uuid. Not an FK.
  actorId   String?        @map("actor_id") @db.VarChar(64)
  actorName String?        @map("actor_name") @db.VarChar(120)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

model Payment {
  id                    String            @id @db.VarChar(64)
  orderId               String            @map("order_id") @db.VarChar(64)
  provider              PaymentProvider
  status                PaymentStatus     @default(PENDING)
  amountUzs             Decimal           @map("amount_uzs") @db.Decimal(14, 2)
  amountTiyin           BigInt?           @map("amount_tiyin")
  deepLink              String?           @map("deep_link")
  httpsFallback         String?           @map("https_fallback")
  providerTransactionId String?           @map("provider_transaction_id") @db.VarChar(120)
  // Provider transaction state machine (Payme states 1/2/-1/-2; Click prepare id).
  providerState         Int?              @map("provider_state")
  providerCreateTime    BigInt?           @map("provider_create_time")
  providerPerformTime   BigInt?           @map("provider_perform_time")
  providerCancelTime    BigInt?           @map("provider_cancel_time")
  cancelReason          Int?              @map("cancel_reason")
  providerPrepareId     String?           @map("provider_prepare_id") @db.VarChar(64)
  paidAt                DateTime?         @map("paid_at") @db.Timestamptz(3)
  expiresAt             DateTime?         @map("expires_at") @db.Timestamptz(3)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  order                 Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  financialRefunds      FinancialRefund[]
  fiscalSnapshot        PaymeFiscalSnapshot?
  fiscalReceipts        PaymeFiscalReceipt[]

  @@unique([provider, providerTransactionId])
  @@index([orderId])
  @@index([status])
  @@index([provider, providerCreateTime])
  @@map("payments")
}

// The receipt agreed for one Payme invoice: the `detail` CheckPerformTransaction hands
// to Payme, frozen when the invoice is created. That call carries only an amount and an
// account, with no transaction id, so the receipt has to exist before it and belongs to
// the invoice; CreateTransaction then binds the transaction to that same row. Once it
// exists, a changed product, category, MXIK or VAT rate does not reach it: those apply
// to the invoices issued afterwards.
//
// Immutable: a database trigger refuses every UPDATE (see the migration), and the money
// trail's rule applies, so a payment holding one cannot be deleted.
model PaymeFiscalSnapshot {
  paymentId  String   @id @map("payment_id") @db.VarChar(64)
  // Exactly what goes on the wire: receipt_type and items.
  detail     Json     @db.JsonB
  // What the lines add up to, compared with the amount Payme asks about.
  totalTiyin BigInt   @map("total_tiyin")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@map("payme_fiscal_snapshots")
}

// Which kind of tax receipt a SetFiscalData callback reports: the sale, or its reversal.
// The tax authority issues them as two different receipts.
enum PaymeFiscalReceiptType {
  PERFORM
  CANCEL
}

// A fiscal receipt Payme registered for a transaction, as reported by SetFiscalData. One
// row per transaction and type, so a repeated callback has nowhere to go but the same
// row, and the receipt for a sale and for its cancellation stay apart.
//
// Payme's documentation does not list the status codes. 0 ("accepted", in its samples)
// is the only one given a meaning here, and the rest are stored as they came. An
// accepted receipt is never overwritten: a later callback saying something else is kept
// beside it (last_conflict_*) for reconciliation.
model PaymeFiscalReceipt {
  paymentId        String                 @map("payment_id") @db.VarChar(64)
  type             PaymeFiscalReceiptType
  // Every field stays as Payme sent it, and each may be absent, as on a registration
  // that failed. `fiscal_date` is the raw "date": its format is not documented either,
  // so no time zone is assumed by parsing it. `qr_code_url` is not checked to be a
  // URL at all (Payme's sample is not one), so whatever shows it to a customer must.
  receiptId        String?                @map("receipt_id")
  statusCode       Int?                   @map("status_code")
  message          String?
  terminalId       String?                @map("terminal_id")
  fiscalSign       String?                @map("fiscal_sign")
  qrCodeUrl        String?                @map("qr_code_url")
  fiscalDate       String?                @map("fiscal_date")
  // The whole fiscal_data object these columns were read from.
  rawData          Json                   @map("raw_data") @db.JsonB
  conflictCount    Int                    @default(0) @map("conflict_count")
  lastConflictData Json?                  @map("last_conflict_data") @db.JsonB
  lastConflictAt   DateTime?              @map("last_conflict_at") @db.Timestamptz(3)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  payment          Payment                @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@id([paymentId, type])
  @@map("payme_fiscal_receipts")
}

// ── Devices, push & notifications ─────────────────────────────────────────────
model Device {
  id                 String         @id @db.VarChar(64)
  userId             String         @map("user_id") @db.Uuid
  installId          String         @map("install_id") @db.VarChar(80)
  platform           DevicePlatform
  expoPushToken      String?        @map("expo_push_token")
  fcmToken           String?        @map("fcm_token")
  apnsToken          String?        @map("apns_token")
  osVersion          String?        @map("os_version") @db.VarChar(40)
  appVersion         String?        @map("app_version") @db.VarChar(40)
  deviceModel        String?        @map("device_model") @db.VarChar(80)
  locale             String?        @db.VarChar(20)
  timezone           String?        @db.VarChar(60)
  permissionsGranted Boolean        @default(false) @map("permissions_granted")
  lastSeenAt         DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
