# Mator Backend — environment variables
# Copy to .env and fill in real values. Never commit the populated .env file.

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Database (Prisma / PostgreSQL) ───────────────────────────────────────────
# Pooled connection used by the app at runtime (e.g. PgBouncer transaction mode).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&pgbouncer=true
# Direct (non-pooled) connection — required for `prisma migrate deploy`.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public

# ── JWT (RS256) ───────────────────────────────────────────────────────────────
# PEM keys. In production these are required — boot fails fast if any are missing.
# Newlines may be encoded as literal "\n" (the app normalizes them at startup).
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"
JWT_KID=replace-with-a-stable-key-id
JWT_AUDIENCE=mator-app

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated browser-origin allowlist. Empty = all browser origins rejected
# in production (the native mobile app sends no Origin and is unaffected).
CORS_ORIGINS=https://app.mator.uz,https://admin.mator.uz

# ── Telegram bot ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
# Chat/group id the AI-chat sourcing tickets are posted to (e.g. -1001234567890).
# The bot must be a member of that group. Leave unset to disable the fan-out.
TELEGRAM_DEALERS_GROUP_ID=REPLACE_WITH_DEALERS_GROUP_ID
# Manager contact the card's «Связаться для доставки» button opens. Accepts an
# @username, a bare username, or a full URL (https://t.me/…, wa.me/…). Unset →
# the card is sent without the button.
TELEGRAM_MANAGER_USERNAME=REPLACE_WITH_MANAGER_USERNAME

# ── Cloudinary (image storage) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=REPLACE_ME
CLOUDINARY_API_KEY=REPLACE_ME
CLOUDINARY_API_SECRET=REPLACE_ME

# ── Photoroom (AI background removal / beautify) ─────────────────────────────
PHOTOROOM_API_KEY=REPLACE_ME

# ── Image processing concurrency (1–10) ────────────────────────────────────────
IMAGE_CONCURRENCY=5

# ── Anthropic (Claude — AI advisor, part parsing & AI chat) ──────────────────
ANTHROPIC_API_KEY=REPLACE_ME
# Set to "true" to bypass live AI calls and use the offline rule-based fallback.
AI_MOCK=false

# ── Email (Resend + verification links) ──────────────────────────────────────
RESEND_API_KEY=REPLACE_ME
MAIL_FROM="Mator <no-reply@mator.uz>"
EMAIL_VERIFY_URL=https://api.mator.uz/v1/auth/verify-email
EMAIL_VERIFY_SUCCESS_URL=https://mator.uz/verify/success
EMAIL_VERIFY_FAILURE_URL=https://mator.uz/verify/failure
# Admin invite emails (invite-only admin signup). RESEND_API_KEY (above) MUST be
# set for invites to send — an unset key makes POST /v1/auth/admin/invites fail
# with 503 rather than silently dropping the invite. RESEND_FROM defaults to
# MAIL_FROM when unset. ADMIN_PANEL_URL is the operator panel base (hidden
# segment included) that invite links point at: ${ADMIN_PANEL_URL}/accept-invite.
RESEND_FROM="Mator <noreply@mator.uz>"
ADMIN_PANEL_URL=https://mator.uz/mtr-ops-ffcb4e84

# ── SMS (phone OTP) ───────────────────────────────────────────────────────────
# eskiz | log ("log" is the safe local/dev no-op default).
SMS_PROVIDER=log
ESKIZ_EMAIL=REPLACE_ME
ESKIZ_PASSWORD=REPLACE_ME
ESKIZ_FROM=REPLACE_ME
ESKIZ_BASE_URL=https://notify.eskiz.uz/api

# ── Push notifications ────────────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=REPLACE_ME
# FCM (Android): paste the full service-account JSON as a single-line string.
FCM_SERVICE_ACCOUNT_JSON=
# APNs (iOS): paste the .p8 key contents. Providers no-op (log only) if unset.
APNS_KEY_P8=

# ── Social login ──────────────────────────────────────────────────────────────
# Comma-separated allowed client/audience IDs.
GOOGLE_CLIENT_IDS=REPLACE_ME
APPLE_CLIENT_IDS=REPLACE_ME

# ── MyID (identity verification) ─────────────────────────────────────────────
MYID_AUTHORIZE_URL=https://myid.uz/oauth2/authorize
MYID_CLIENT_ID=mator-dev
MYID_VERIFIED_LIMIT_UZS=

# ── Payments ───────────────────────────────────────────────────────────────────
# Comma-separated enabled providers, e.g. "payme,click".
PAYMENT_PROVIDERS=payme,click
PAYME_MERCHANT_KEY=REPLACE_ME
PAYME_ACCOUNT_FIELD=order_id
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
CLICK_MERCHANT_ID=REPLACE_ME
CLICK_SERVICE_ID=REPLACE_ME
CLICK_SECRET_KEY=REPLACE_ME

# ── Orders / shipping / retention (business config, all optional — sane defaults) ──
# Cash and terminal orders wait for an operator, not for an online payment, so
# ORDER_TTL_MIN does not apply to them. All in hours; see offline-order.policy.ts.
# Past the SLA an order is flagged overdue in the console (changes nothing else).
OFFLINE_ORDER_SLA_HOURS=2
# Past this the console warns about the order on every screen, not only in the
# queue (changes nothing else). 0 = off.
OFFLINE_ORDER_OPERATOR_WARNING_HOURS=4
# Tell the customer once that confirmation is late. 0 = off.
OFFLINE_ORDER_CUSTOMER_NOTICE_HOURS=0
# Expire the order and tell the customer. 0 = off; while off, an unattended order
# stays open and blocks its customer's account deletion until an operator acts.
OFFLINE_ORDER_TIMEOUT_HOURS=0
ORDER_TTL_MIN=30
SERVICE_FEE_UZS=5000
RETENTION_DAYS=90

# ── Courier delivery pricing ──────────────────────────────────────────────────
# UzMaps routing key (https://docs.uzmaps.uz/keys-usage/). REQUIRED in production:
# boot fails without it. Elsewhere it may stay empty, and courier delivery is then
# refused with 503 DELIVERY_ROUTING_UNAVAILABLE. Backend only: never give it to the app.
UZMAPS_API_KEY=
# Rates, in whole UZS. Leave unset for the defaults in src/shipping/delivery-pricing.ts,
# shown here. A value that is set but invalid stops the boot.
# Price per billable kilometre, starting with the first:
# DELIVERY_TIER_PRICES_UZS=5000,7000,9000,12000,15000,18000,21000,24000,27000,30000
# Added per kilometre beyond that list:
# DELIVERY_EXTRA_KM_PRICE_UZS=2500
# VAT percent on the delivery line of a Payme receipt, as approved by the accountant.
# While unset, Payme refuses every order that has a delivery cost. No default on purpose.
DELIVERY_VAT_PERCENT=

AUTH_DEV_MODE=false
# ── 3D DB Blueprint (operator-only schema visualizer) ─────────────────────────
# Real-time Sci-Fi visualization of the Postgres schema + live query pulses.
# Mounted only when enabled; OFF in production unless BLUEPRINT_ENABLED=true
# (mirrors the Swagger gate). Leaks schema shape + query patterns, so it is
# operator-only.
#   BLUEPRINT_ENABLED         true|false. Unset ⇒ on outside production, off in prod.
#   BLUEPRINT_TOKEN           Server-to-server secret the admin panel sends as
#                             `x-blueprint-token` to read the graph + mint WS
#                             tickets. Unset ⇒ every blueprint request is denied.
#   BLUEPRINT_TICKET_SECRET   HMAC key for the short-lived WS tickets. Optional —
#                             falls back to BLUEPRINT_TOKEN.
BLUEPRINT_ENABLED=true
BLUEPRINT_TOKEN=
BLUEPRINT_TICKET_SECRET=

# --- AI sourcing requests (all optional except the switch for go-live) ---
# Release switch. false: chat and catalogue matches work, no tickets are created.
# Setting it back to false is the fastest rollback.
SOURCING_TICKETS_ENABLED=false
# Internal chat for tickets nobody picked up, or that failed to reach dealers.
# Unset: the alert only goes to the admin console.
TELEGRAM_SOURCING_ESCALATION_CHAT_ID=REPLACE_WITH_INTERNAL_CHAT_ID
SOURCING_STAFF_NOTIFY_MAX_ATTEMPTS=8
SOURCING_ESCALATE_AFTER_MINUTES=30
SOURCING_NO_OFFER_AFTER_HOURS=48
SOURCING_OFFER_TTL_HOURS=72
SOURCING_DUPLICATE_WINDOW_MINUTES=60
# Keep the wait and model timeout below the app's 45-second request timeout.
SOURCING_IDEMPOTENCY_LEASE_SECONDS=60
SOURCING_IDEMPOTENCY_WAIT_SECONDS=30
SOURCING_LLM_TIMEOUT_SECONDS=18
